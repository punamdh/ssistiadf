          "text" : {
            "value" : "UPDATE [ReconControl].[dbo].[tbl_Ceo_Wires]\nSET USDe = (a.Amount / b.SPOTRATE_8)\nFROM [ReconControl].[dbo].[tbl_Ceo_Wires]    A\nJOIN ReconControl.dbo.tbl_OTC_FX_Rates B\nON A.CCY = B.CCY \nWHERE B.TERMS = 'D' and cast(B.LSTMNTDATE as date)=cast(A.Value_Date as date)\nand cast(A.LoadDate as date)=cast(getdate() as date)\n;\nUPDATE [ReconControl].[dbo].[tbl_Ceo_Wires] \nSET USDe = (a.Amount * b.SPOTRATE_8)\nFROM [ReconControl].[dbo].[tbl_Ceo_Wires]    A\nJOIN ReconControl.dbo.tbl_OTC_FX_Rates B\nON A.CCY = B.CCY \nWHERE B.TERMS = 'M' and cast(B.LSTMNTDATE as date)=cast(A.Value_Date as date)\nand cast(A.LoadDate as date)=cast(getdate() as date)",
