          "onInactiveMarkAs" : null,
          "linkedServiceName" : {
            "referenceName" : "OLEDB_OraOLEDB_Oracle_1",
            "type" : "LinkedServiceReference"
          },
          "typeProperties" : {
            "scripts" : [ {
              "type" : "Query",
              "text" : {
                "value" : "select FileNme, busGrp \nfrom\n(\nSelect ba.entity_id, b.book_name, tr.trade_status, trunc(modif_date) as amend_date, bav.attribute_name as crd_Book, modif_date,\ncase when bav.attribute_value = 'Investment Solutions' then 'PnlByTradeDetails_CVA_FISNT_'\nwhen bav.attribute_value = 'Fixed Income Structured Notes Trading' then 'PnlByTradeDetails_CVA_FISNT_'\n else 'NA' end as FileNme,\nCase when bav.attribute_value = 'Investment Solutions' then 'IS'\nwhen bav.attribute_value = 'Fixed Income Structured Notes Trading' then 'FISNT'\n else 'NA' end as busGrp\nfrom CALYPSODBA.BO_AUDIT ba INNER JOIN CALYPSODBA.TRADE tr ON tr.trade_id = ba.entity_id  inner join CALYPSODBA.BOOK_ATTR_VALUE bav on tr.book_id = bav.book_id\nINNER JOIN CALYPSODBA.BOOK b on b.book_id = tr.book_id\nwhere ba.entity_class_name = 'Trade'  \nand bav.attribute_value in('Investment Solutions', 'Fixed Income Structured Notes Trading')\nand ba.modif_date > = TRUNC(SYSDATE - 1, 'DD') and ba.Modif_date < TRUNC(SYSDATE, 'DD')\nand entity_id in \n(Select t.trade_id\nfrom CALYPSODBA.TRADE t\ninner join  CALYPSODBA.BOOK_ATTR_VALUE b on b.book_id = t.book_id\nWHERE ATTRIBUTE_VALUE in('Investment Solutions', 'Fixed Income Structured Notes Trading') and \nt.trade_status NOT in ('CH_AFFIRMED', 'CH_PENDING', 'CH_REJECT', 'CONSENT_PENDING', 'DAY_RECONCILED', 'DAY_TERM_ERROR', 'DAY_TERMINATED', \n'DAY_TRM_ERR_APRV', 'FCM_REJECT', 'FCM_REJECT_HOLD', 'FO_REVIEW_NPF', 'INVALID', 'MO_APPROVED', 'NC_CANCELED', 'NC_CONSENT_PEND', 'NC_PENDING', \n'PLACEHOLDER', 'PRICING', 'PRICING_MAT', 'RECONCILED', 'RISK_OTHER', 'SENT_TO_CH', 'HEDGE_TODAY', 'HEDGE_CLOSE', 'HEDGE_INTRAD'))\nUnion\nSelect ba.entity_id, b.book_name, tr.trade_status, trunc(modif_date) as amend_date, bav.attribute_name as crd_Book, modif_date,\ncase when bav.attribute_name = 'CptyCredit_ABF' then 'PnlByTradeDetails_CRD_CVA_ABF_' \nwhen bav.attribute_name = 'CptyCredit_ABS' then 'PnlByTradeDetails_CRD_CVA_ABS_'\n when bav.attribute_name = 'CptyCredit_CIB' then 'PnlByTradeDetails_CRD_CVA_CIB_'\n when bav.attribute_name = 'CptyCredit_Liquid' then 'PnlByTradeDetails_CRD_CVA_LIQ_'\n when bav.attribute_name = 'CptyCredit_RPS' then 'PnlByTradeDetails_CRD_CVA_RPS_'\n when bav.attribute_name = 'CptyCredit_Muni' then 'PnlByTradeDetails_CRD_CVA_MUN_'\n else 'NA' end as FileNme,\n case when bav.attribute_name = 'CptyCredit_ABF' then 'CVA-ABF' \nwhen bav.attribute_name = 'CptyCredit_ABS' then 'CVA-ABS'\n when bav.attribute_name = 'CptyCredit_CIB' then 'CVA-CIB'\n when bav.attribute_name = 'CptyCredit_Liquid' then 'CVA-LIQ'\n when bav.attribute_name = 'CptyCredit_RPS'  then 'CVA-RPS'\n  when bav.attribute_name = 'CptyCredit_Muni' then 'CVA-MUN'\n else 'NA' end as busGrp\nfrom CALYPSODBA.BO_AUDIT ba INNER JOIN CALYPSODBA.TRADE tr ON tr.trade_id = ba.entity_id  inner join CALYPSODBA.BOOK_ATTR_VALUE bav on tr.book_id = bav.book_id\nINNER JOIN CALYPSODBA.BOOK b on b.book_id = tr.book_id\nwhere ba.entity_class_name = 'Trade'  \nand bav.attribute_name in ('CptyCredit_Muni', 'CptyCredit_RPS', 'CptyCredit_Liquid', 'CptyCredit_CIB', 'CptyCredit_ABF', 'CptyCredit_ABS') and bav.ATTRIBUTE_VALUE = 'Yes'\nand ba.modif_date > = TRUNC(SYSDATE - 1, 'DD') and ba.Modif_date < TRUNC(SYSDATE, 'DD')\nand entity_id in \n(Select t.trade_id\nfrom CALYPSODBA.TRADE t\ninner join  CALYPSODBA.BOOK_ATTR_VALUE b on b.book_id = t.book_id\nWHERE ATTRIBUTE_NAME in ('CptyCredit_Muni', 'CptyCredit_RPS', 'CptyCredit_Liquid', 'CptyCredit_CIB', 'CptyCredit_ABF', 'CptyCredit_ABS') AND ATTRIBUTE_VALUE ='Yes' and \nt.trade_status NOT in ('CH_AFFIRMED', 'CH_PENDING', 'CH_REJECT', 'CONSENT_PENDING', 'DAY_RECONCILED', 'DAY_TERM_ERROR', 'DAY_TERMINATED', \n'DAY_TRM_ERR_APRV', 'FCM_REJECT', 'FCM_REJECT_HOLD', 'FO_REVIEW_NPF', 'INVALID', 'MO_APPROVED', 'NC_CANCELED', 'NC_CONSENT_PEND', 'NC_PENDING', \n'PLACEHOLDER', 'PRICING', 'PRICING_MAT', 'RECONCILED', 'RISK_OTHER', 'SENT_TO_CH', 'HEDGE_TODAY', 'HEDGE_CLOSE', 'HEDGE_INTRAD')))\ngroup by FileNme, busGrp",
                "type" : "Expression"
              }
            } ],
