      "linkedServiceName" : {
        "referenceName" : "OLEDB_MSOLEDBSQL_1_2",
        "type" : "LinkedServiceReference"
      },
      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "SELECT '117' as Client, [Balance Pool ] as [Balance Pool],[Account Name],[Department],[Entry Date],[Risk Date],[CUR],[Side],[D C] as [Debit Or Credit], TRY_CAST(REPLACE([Amount],',','') as float) as [Amount],\n      TRY_CAST(REPLACE([EQ Amount],',','') as float) as [Eq Amount],\n      CASE WHEN [Trans Ref] = '' THEN '01010000' ELSE [Trans Ref] END as [BR Account],[Desc 1] as Desc1,[Desc 2] as Desc2,[Desc3],[Narrative],[Cusip],[Product ID],[Case #],[Misc Info],[A S],[Ext #],[Review Date],\n\t  [Ops Control ],[Item State],[Age],[Source Name],[GL Category],[Pega Case Id],[Pega Case Status],[Account Infor],\n\t  [Add'l Info],[Deal Number],[Draft Number],[Pay Park Ref],[TMSRef],[Item Id],[Next Date],[User Text117],[Effective Date],\n\t  [Entered Date],[BCO],[Description],[Hdr Dtl ID],[Header ID],[Ref Number],[Trans Type],[User1],[User2],[TW Customer Name]\n      ,[loadDate],cusip + TRY_CAST(ABS(TRY_CAST(REPLACE([EQ Amount],',','') as float)) as varchar(20)) as [key]\n\t  ,CASE WHEN [Balance Pool ] LIKE '%p&i%' THEN 'pni' \n\t\t    WHEN [Balance Pool ] LIKE '%pni%' THEN 'pni'\n\t\t\tWHEN [Balance Pool ] LIKE '%bony%' THEN 'cash'\n\t\t    WHEN [Balance Pool ] LIKE '%long%' THEN 'open items'\n\t\t    WHEN [Balance Pool ] LIKE '%short%' THEN 'open items'\n\t   END as [grouping]\n\tINTO #tbl_outstanding_items\n\tFROM [ReconControl].[dbo].[tbl_Intellimatch_AutoMatch_Daily_WFB]\n\tWHERE [Balance Pool ] IS NOT NULL AND [Cusip] != '' AND CUR = 'USD'\n\n\t--AND Cusip = '89346D107'\n\n\tINSERT INTO #tbl_outstanding_items\n\tSELECT '127' as Client, [Balance Pool ] as [Balance Pool],[Account Name],[Department],[Entry Date],[Risk Date],[CUR],[Side],[D C] as [Debit Or Credit], TRY_CAST(REPLACE([Amount],',','') as float) as [Amount],\n      TRY_CAST(REPLACE([EQ Amount],',','') as float) as [Eq Amount],\n      CASE WHEN [Trans Ref] = '' THEN '01010000' ELSE [Trans Ref] END as [BR Account],[Desc 1] as Desc1,[Desc 2] as Desc2,[Desc3],[Narrative],[Cusip],[Product ID],[Case #],[Misc Info],[A S],[Ext #],[Review Date],\n\t  [Ops Control ],[Item State],[Age],[Source Name],[GL Category],[Pega Case Id],[Pega Case Status],[Account Infor],\n\t  [Add'l Info],[Deal Number],[Draft Number],[Pay Park Ref],[TMSRef],[Item Id],[Next Date],[User Text117],[Effective Date],\n\t  [Entered Date],[BCO],[Description],[Hdr Dtl ID],[Header ID],[Ref Number],[Trans Type],[User1],[User2],[TW Customer Name]\n      ,[loadDate],cusip + TRY_CAST(ABS(TRY_CAST(REPLACE([EQ Amount],',','') as float)) as varchar(20)) as [key]\n\t  ,CASE WHEN [Balance Pool ] LIKE '%p&i%' THEN 'pni' \n\t\t    WHEN [Balance Pool ] LIKE '%pni%' THEN 'pni'\n\t\t\tWHEN [Balance Pool ] LIKE '%bony%' THEN 'cash'\n\t\t    WHEN [Balance Pool ] LIKE '%long%' THEN 'open items'\n\t\t    WHEN [Balance Pool ] LIKE '%short%' THEN 'open items'\n\t   END as [grouping]\n\tFROM [ReconControl].[dbo].[tbl_Intellimatch_AutoMatch_Daily_WFS]\n                WHERE [Balance Pool ] IS NOT NULL AND [Cusip] != '' AND CUR = 'USD'\n\n\n\t--Try loading matched cusips and groups\n\tSELECT Client, Cusip, Sum(Amount) AS SumOfAmount, Count(Cusip) AS CountOfCusip,  null as grouping\t--grouping\n\tINTO #qry_Offset_Stage_1\t\n\tFROM  #tbl_outstanding_items\n\tGROUP BY Client, Cusip--, grouping\n\tHAVING (((Sum(Amount))>-0.99 And (Sum(Amount))<0.99) AND ((Count(Cusip))>1));\t\n\t\n\t----Clear Final Report Table\n\tEXECUTE dbo.spTruncateTable 'dbo.tbl_Intellimatch_AutoMatch_Daily'\n\n\t---- Load Final Report Table\n\tINSERT INTO [dbo].[tbl_Intellimatch_AutoMatch_Daily]\n\n\tSELECT CAST(GETDATE() as date) as RptDate, t.Client, (Left([BR Account],3) + '-' + SUBSTRING([BR Account],4,5) + '-1X') as Account, t.[Cusip] as Security, \n\tCASE t.CUR WHEN 'USD' THEN '000' WHEN 'EUR' THEN '052' WHEN 'GBP' THEN '003' WHEN 'AUD' THEN '010' WHEN 'NOK' THEN '019' ELSE t.CUR END as CCY, \n\tCASE WHEN t.[Amount] < 0 THEN 'D' ELSE 'C' END  as DRCR, t.[Amount]*-1 as Amt, '0' as Qty, 'DV' as BatchCode, 'ADJ' as EntryCode, '' as [Rejects code], \n\t'RD-' + (cast(month(t.[Risk Date]) as varchar)+'/'+cast(day(t.[Risk Date]) as varchar)+'/'+ cast(year(t.[Risk Date]) as varchar)) + ' ID-' + t.[Item Id] as Misc,\n\t'B' as TRIDCode, '' as SPINCode, '' as DDACode, Department\n\tFROM #tbl_outstanding_items t INNER JOIN #qry_Offset_Stage_1 i ON t.Cusip = i.Cusip AND t.Client = i.Client --AND t.grouping = i.grouping\n\t\n\tUNION ALL\n\t\n\tSELECT DISTINCT CAST(GETDATE() as date) as RptDate, t.Client, '091-99860-1X' as Account, t.[Cusip] as Security,\n\tCASE t.CUR WHEN 'USD' THEN '000' WHEN 'EUR' THEN '052' WHEN 'GBP' THEN '003' WHEN 'AUD' THEN '010' WHEN 'NOK' THEN '019' ELSE t.CUR END as CCY, \n\tCASE WHEN i.[SumOfAmount] > 0 THEN 'D' ELSE 'C' END  as DRCR, ROUND(i.[SumOfAmount],2) as Amt, '0' as Qty, 'DV' as BatchCode, 'ADJ' as EntryCode, '' as [Rejects code], \n\t'RD-' + (cast(month(GETDATE()) as varchar)+'/'+cast(day(GETDATE()) as varchar)+'/'+ cast(year(GETDATE()) as varchar)) + ' write off' as Misc,\n\t'B' as TRIDCode, '' as SPINCode, '' as DDACode, '' as Department\n\tFROM #tbl_outstanding_items t INNER JOIN #qry_Offset_Stage_1 i ON t.Cusip = i.Cusip AND t.Client = i.Client --AND t.grouping = i.grouping\n\tWHERE i.[SumOfAmount] NOT BETWEEN -0.009 AND 0.009\n\tORDER BY Security, Misc\n\n\n\tDROP TABLE #tbl_outstanding_items\t\n\tDROP TABLE #qry_Offset_Stage_1",
            "type" : "Expression"
          }
        } ],
