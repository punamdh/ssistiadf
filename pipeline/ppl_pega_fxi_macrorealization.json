          "text" : {
            "value" : "USE ReconControl\n;\nUPDATE tbl_PaymentTracker_PegaMessages_by_Dealnumber\nSET Import_Date = GETDATE() WHERE Import_Date IS NULL \n\n;\n\nupdate tbl_Pega_Messages_SCOP_FX \nset import_date =getdate()\nwhere import_date is null\n\n;\n\nupdate tbl_FX_Aging_Summary_Main_AgingReport \nset import_date = getdate()\nwhere import_date is null \n;\n\nupdate tbl_Pega_Messages_SCOP_FX\nset MsgType ='R'\nwhere MsgType LIKE 'FXMS'\n;\nupdate tbl_Pega_Messages_SCOP_FX\nset MsgType ='S'\nwhere MsgType LIKE 'SCOP'\n;\ndelete from ReconControl.dbo.tbl_Pega_Messages_SCOP_FX where isdate(SUBSTRING(ID,5,2)+'-'+SUBSTRING(ID,7,2)+'-'+SUBSTRING(ID,3,2)) = 0\n;\n\n  update ReconControl.dbo.tbl_FX_Aging_Summary_Main_AgingReport\n  set Aging = datediff(day,cast( SUBSTRING([case id],6,2)+'/'  +substring([case id],8,2) +'/'+ +substring([case id],4,2) as date),getdate()) \n  where  Aging > 1000 ;\n\n",
            "type" : "Expression"
          }
        } ],
