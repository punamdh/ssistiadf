          "text" : "Declare @run_Key int\nDeclare @run_end_date varchar(30)\nselect @run_Key=@var_Dw_Run_Key\nselect @run_end_date=@var_Dw_Effective_End_Date\n\n--Delete Current Run Key Data\nDELETE FROM dw.D_CurrentStages WHERE (DW_Run_Key = @run_Key)\n\n--Update Effective End Date for records whose DW_Update_Run_key= Current Run Key\nupdate dw.D_CurrentStages \nset DW_Effective_End_date=CONVERT(Datetime,@run_end_date),DW_Current_Flag = 1,DW_Upsert_Flag='I',DW_Update_Run_key=DW_Run_Key \nwhere DW_Update_Run_key>=@run_Key\n\n\n\n\n"
