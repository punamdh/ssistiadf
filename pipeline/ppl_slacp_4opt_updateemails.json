          "text" : {
            "value" : "--UPDATE b\n--SET b.[after] = a.[newAddress], \n--\tb.dateAction = CAST(GETDATE() AS date), \n--\tb.timeAction = CAST(GETDATE() AS time)\n--FROM tbl_SLACP_emailAddress_newUpdates a \n--\tINNER JOIN tbl_SLACP_emailAddress_audit b \n--\t\tON a.contraparty = b.contraparty \n--WHERE b.dateAction IS NULL \n--\tAND b.timeAction IS NULL;\n\nUPDATE a\nSET a.emailAddress2 = b.[newAddress], \n\ta.testEmailAddress2 = 'jennifer.gargrave@wellsfargo.com'\nFROM tbl_SLACP_contraparties a\n\tINNER JOIN tbl_SLACP_emailAddress_newUpdates b \n\t\tON a.contraParty = b.contraparty;\n\nUPDATE a \nSET a.emailAddress2 = b.[newAddress], \n\ta.testEmailAddress2 = 'jennifer.gargrave@wellsfargo.com'\nFROM tbl_SLACP_counterparty_list a \n\tINNER JOIN tbl_SLACP_emailAddress_newUpdates b \n\t\tON a.contraParty = b.contraparty \nWHERE b.newAddress IS NOT NULL;",
            "type" : "Expression"
