          "type" : "NonQuery",
          "text" : {
            "value" : "DECLARE @busDate AS Date;\nSET @busDate = (SELECT CAST(CurrentDate as Date) \n\t\t\t\tFROM Utility.dbo.Calendar \n\t\t\t\tWHERE CAST(CurrentDate as Date)  = Cast(getDate() as Date))\n\nINSERT INTO ReconControl.dbo.tbl_Broadridge_TFR_NDO_Volume (\n\t\tloadDate,\n\t\tsettlementDate,\n\t\tNDOVolume\n\t\t)\nSELECT *\nFROM (\n\t\tSELECT \n\t\t\tGetDate() as loadDate,\n\t\t\t@busDate AS settlementDate,\n\t\t\tNull AS NDOVolume\n\t) AS b\nWHERE NOT EXISTS (\n\t\tSELECT c.settlementDate\n\t\tFROM ReconControl.dbo.tbl_Broadridge_TFR_NDO_Volume c\n\t\tWHERE c.settlementDate = b.settlementDate\n\t\t\t\t)",
            "type" : "Expression"
          }
        } ],
