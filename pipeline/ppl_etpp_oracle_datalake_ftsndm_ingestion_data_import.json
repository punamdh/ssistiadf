      "selectquery" : {
        "type" : "String",
        "defaultValue" : "SELECT       BAT.BUSINESS_APPLICATION_WF_GUID     , BAT.BUSINESS_APPLICATION_NAME     , BAT.DEST_LVL1_NAME     , BAT.DEST_LVL1_SYS_CLASS_NAME     , BAT.DEST_LVL1_WF_GUID     , BAT.DEST_LVL2_NAME     , BAT.DEST_LVL2_SYS_CLASS_NAME     , BAT.DEST_LVL2_WF_GUID     , im.DISPLAY_NAME     , iss.DEVICE_GUID     , dev.DEVICE_WF_GUID     , dev.host_name AS DEVICE_NAME     , dev.DEVICE_SYS_CLASS_NAME     , dev.ENVIRONMENT_DESCRIPTION     , dev.SYS_UPDATED_ON     , dev.SYS_CREATED_ON     , dev.OPERATION_STATUS_DESCRIPTION     , dev.DATA_CENTER_NAME     , dev.LOCATION_NAME     , dev.DATA_CENTER_NEIGHBORHOOD     , dev.DATA_CENTER_ZONE     , dev.U_RPT_CPU_TOTAL_CORES     , dev.U_DC_NEIGHBORHOOD     , dev.U_DC_ZONE     , dev.U_NEW_PUBLICLY_ACCESSIBLE     , dev.COMMON_NAME     , dev.U_DC_NEIGHBORHOOD_NAME     , dev.U_DC_ZONE_NAME     , iss.DISCOVERED_PRODUCT_NAME     , iss.DISCOVERED_PUBLISHER     , iss.INSTALL_DATE     , iss.INSTALL_LOCATION     , iss.INSTALLED_ON     , iss.SOFTWARE_MODEL     , iss.PACKAGE_NAME     , iss.LAST_MATCHED_DATE     , iss.TSC_PUBLISHER_ID     , iss.TSC_VERSION_ID     , iss.TSC_PRODUCT_ID     , iss.PARENT_PRODUCT     , iss.PARENT_PRODUCT_NAME FROM itm_curated.itmp_software_product_model im INNER JOIN itm_curated.installed_software iss     ON iss.TSC_RELEASE_ID = im.U_TSC_RELEASE_ID INNER JOIN itm_curated.device_dimension dev     ON iss.DEVICE_GUID = dev.DEVICE_WF_GUID JOIN ITM_CURATED.BUSINESS_APPLICATION_TOPOLOGY BAT     ON dev.DEVICE_WF_GUID = BAT.DEST_LVL2_WF_GUID WHERE UPPER(im.TSC_NAME) LIKE '%STERLING CONNECT:DIRECT%'   AND iss.OPERATIONAL_STATUS_DESCRIPTION NOT IN       (           'RETIRED',           'NON-OPERATIONAL'       )   AND dev.operation_status_description NOT IN       (           'RETIRED',           'NON-OPERATIONAL'       )"
