              "type" : "NonQuery",
              "text" : {
                "value" : ";WITH dt AS\n(\nSELECT CAST(SUBSTRING(SourceCompositeKey,0,CHARINDEX('|',SourceCompositeKey,0)) as smallint) as weekID\n,CAST(SUBSTRING(SourceCompositeKey,CHARINDEX('|',SourceCompositeKey,0)+1,10) as smallint) as metricID\n,TRY_CAST(TextTag as decimal(18,4)) as metricValue\nFROM [dbo].[tbl_DataTagger_Tags] \nWHERE SourceDataSetID = 39\nAND SUBSTRING(SourceCompositeKey,0,CHARINDEX('|',SourceCompositeKey,0)) = \n (\n SELECT MAX(SUBSTRING(SourceCompositeKey,0,CHARINDEX('|',SourceCompositeKey,0)))FROM [dbo].[tbl_DataTagger_Tags]  WHERE SourceDataSetID = 39)\n )\nUPDATE t\n  SET t.metricValue = dt.metricValue\n  FROM [kpikriReporting].[dbo].[tbl_lvlTwoDetail_spTacticalMetrics] AS t\n  INNER JOIN dt\n  ON t.periodCounterWeek = dt.weekID AND t.kriID = dt.metricID;",
                "type" : "Expression"
              }
            } ],
