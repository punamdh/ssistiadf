        "type" : "String",
        "defaultValue" : "SELECT b.balance_id, b.EFF_DT AS EffDATE,SUBSTR(b.ledger,-3) AS CLIENT_NBR,b.Account AS BR_ACCOUNT_NM,b.Currency AS ISO_CURRENCY_CD ,b.Corporate_Ledger_Account AS CorporateLedgerAccount,SUBSTR(b.Account,1,3) AS BR_BRANCH_CD ,CASE SUBSTR(b.ledger,-3) WHEN '095' THEN '01139' WHEN '140' THEN '01400' WHEN '117' THEN '00000' WHEN '127' THEN '00037' ELSE '' END AS GL_COMPANY_CD ,cla.account_number AS GL_ACCOUNT_CD ,pa.organizational_unit AS GL_AU_CD ,b.ptd_balance ,b.ytd_balance ,LTD_Balance ,b.instrument, i.isin ,i.cusip ,i.sedol ,i.bps_inst_ref, SUBSTR(Trading_Account,-4) AS trader ,pa.account_name ,b.trading_account FROM GPTM_NAPE.BALANCE_HIST b LEFT OUTER JOIN gptm_nape.corp_ledger_account_hist cla ON b.eff_dt = cla.eff_dt AND b.corporate_ledger_account = cla.df_ref LEFT OUTER JOIN gptm_nape.party_account_hist pa ON b.eff_dt = pa.eff_dt AND b.trading_account = pa.df_ref LEFT OUTER JOIN gptm_nape.instrument_hist i ON b.eff_dt = i.eff_dt AND b.instrument = i.df_ref WHERE b.EFF_DT =  '17-FEB-23'"
