          "type" : "NonQuery",
          "text" : {
            "value" : "\n--UPDATE dbo.tbl_Opics_PaymentsMetrics_Staging\n--SET USDEQ = (a.AMOUNTNUMERIC / b.SPOTRATE_8)\n--FROM dbo.tbl_Opics_PaymentsMetrics_Staging A\n-- JOIN ReconControl.dbo.tbl_Opics_Fx_Rates B\n--ON A.CURRENCY = B.CCY AND A.BRANCH = B.BR \n--WHERE B.TERMS = 'D' \nUPDATE ReconControl.dbo.tbl_Opics_PaymentsMetrics_Staging \nSET USDEQ = (a.AMOUNTNUMERIC / b.SPOTRATE_8)\nFROM ReconControl.dbo.tbl_Opics_PaymentsMetrics_Staging A\nJOIN ReconControl.dbo.tbl_OTC_FX_Rates B\nON A.CURRENCY = B.CCY AND A.BRANCH = B.BR \nWHERE B.TERMS = 'D' and (cast(B.LSTMNTDATE as date)=cast(A.VDate as date)\nor cast(B.LSTMNTDATE as date)=Try_cast(A.PAYMENTDATE as date))",
