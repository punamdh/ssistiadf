            "value" : "DECLARE @Email_address1 VARCHAR(MAX)\nSET @Email_address1=''\n \nSELECT  @Email_address1 = @Email_address1 + Email_address +','\nFROM    ( SELECT Email   as Email_address\n\t\t  FROM [dbo].[tbl_RTS_EOD_Sales_Email_List]\n\t\t  WHERE DeskName in (select distinct desk_name from  dbo.tbl_Rates_EOD_Approved)\n\t\t  OR DeskName = 'COREDISTR'\n\t\t  UNION \n\t\t  SELECT b.email_address\t  \n\t\t  FROM  dbo.tbl_Rates_EOD_Approved a\n\t\t  JOIN dbo.tbl_lkp_RTS_EOD_Email b\n\t\t  ON a.ratesmoemail = b.ratesmoemail ) email\n\t\t  \n\t  \nUPDATE [AutomatedDistributionService].[dbo].[Template]\nSET ToGroup = SUBSTRING(@Email_address1,1,len(@Email_address1)-1) \nWHERE ((IsFailureTemplate IS NULL) OR (IsFailureTemplate = 0)) and\n Process_Id = CASE WHEN DATEPART(hh,getdate())  IN  (17,5, 16,4) \n\t\t\t\t\t\t\t   THEN 448\n\t\t\t\t\t\t\t WHEN DATEPART(hh,getdate()) IN (19,7, 18, 6)\n\t\t\t\t\t\t\t   THEN 449\nEND",
