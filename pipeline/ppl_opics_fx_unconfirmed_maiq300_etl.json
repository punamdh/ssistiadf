      },
      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "\n\n\nUPDATE [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_MAIQ300_Archive]\nSET TotalConfirmation = (\n    SELECT COUNT(*)\n    FROM [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_MAIQ300_Archive]\n    WHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date)\n)\nWHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date);\n\n\nUPDATE [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_MAIQ300_Archive]\nSET Age = DATEDIFF(Day,DealDate, LoadDate)\nWHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date);\n\n   \nUPDATE rc\nSET rc.SettlementAmount =\n   CASE\n        WHEN fx.TERMS = 'D'\n            THEN CAST(replace(rc.[Amount Sold],',','') AS decimal(18,4)) / fx.SPOTRATE_8\n        ELSE\n            CAST(replace(rc.[Amount Sold],',','') AS decimal(18,4)) * fx.SPOTRATE_8\n    END\nFROM [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_MAIQ300_Archive] rc\nJOIN [ReconControl].[dbo].[tbl_OTC_FX_Rates] fx\n    ON rc.[Sold CCY] = fx.CCY\n   \n  and  CAST(fx.LSTMNTDATE AS date) =CAST(DATEADD(DAY, CASE DATENAME(WEEKDAY, GETDATE()) \n                    WHEN 'Sunday' THEN -2\n                    WHEN 'Monday' THEN -3\n                    ELSE -1 END, DATEDIFF(DAY, -0, GETDATE())) AS date)\nWHERE CAST(rc.Loaddate AS date) = CAST(GETDATE() AS date);\n\n\n\n",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
