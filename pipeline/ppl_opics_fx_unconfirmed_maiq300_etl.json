          "text" : {
            "value" : " \ninsert into [ReconControl].[dbo].[tbl_Opics_FX_Unconfirmed_Combined]\nselect \n\t\t'MAIQ300' as Source ,\n\t\t Branch ,\n\t\t Status ,\n\t\t DEALNO as DealNumber ,\n\t\t [Bought CCY] as BoughtCCY ,\n\t\t [Amount Bought] as AmountBought ,\n\t\t [Sold CCY] as SoldCCY ,\n\t\t [Amount Sold] as AmountSold ,\n\t\t SENDERREF as SENDERREF ,\n\t\t DEALDATE ,\n\t\t CUSTBIC as CUSTBIC ,\n\t\t [Customer Name] as CustomerName ,\n\t\t Vdate as ValueDate ,\n\t\t Age ,\n\t\t SettlementAmount ,\n         Getdate() as LoadDate, \n\t\t Getdate() as ReportDate\n from [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_MAIQ300_Archive]\n WHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date);",
            "type" : "Expression"
