            "value" : "select count(a.trade_id) as ClyRecCount\nfrom\n(\nSELECT tf.TRADE_ID, \nb.BOOK_NAME, \ntf.FEE_DATE, \ntf.FEE_TYPE, \ntf.CURRENCY_CODE, \ntf.AMOUNT, \nle.SHORT_NAME AS Legal_Entity, \ncase when tf.AMOUNT<0 then 'Pay' else 'Receive' end AS Pay_Rec, \ntf.FEE_DESC AS Description\nfrom CALYPSODBA.trade t inner join CALYPSODBA.legal_entity le on le.legal_entity_id = t.cpty_id\ninner join CALYPSODBA.book b on b.book_id = t.book_id\ninner join CALYPSODBA.trade_fee tf on tf.trade_id = t.trade_id\nWHERE tf.FEE_TYPE In ('CASHADJ','CASHFOADJ','CASHBOADJ') \nAND t.TRADE_STATUS Not In ('PRICING','CANCELED','INVALID','RECONCILED','LOST')\nand tf.fee_Date between add_months(trunc(sysdate, 'month'), -12) and trunc(sysdate, 'month'))a",
