            "scripts" : [ {
              "type" : "NonQuery",
              "text" : {
                "value" : "WITH NOTNULLValues\nAS\n(\n\tSELECT distinct effective_date, catalyst_trade_number, action\n\tFROM [ReconControl].[dbo].[tbl_Catalyst_Trade]\n\tWhere cast(entry_time as date) = @item.name\n\tand action is NOT NULL\n)\n\n\nUpdate a\nSet a.action = b.action\nFROM [ReconControl].[dbo].[tbl_Catalyst_Trade] a\nLEFT OUTER JOIN NOTNULLValues b ON a.effective_Date = b.effective_Date AND a.catalyst_trade_number = b.catalyst_trade_number\nWhere a.effective_date = @item.name\n and a.action is NULL",
                "type" : "Expression"
              }
            } ],
            "scriptBlockExecutionTimeout" : null
          }
        } ]
      }
