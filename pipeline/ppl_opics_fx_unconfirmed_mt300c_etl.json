          "typeProperties" : {
            "scripts" : [ {
              "type" : "NonQuery",
              "text" : {
                "value" : "insert into [ReconControl].[dbo].[tbl_Opics_FX_Unconfirmed_Combined]\nselect \n\t\t'MT300C' as Source ,\n\t\t Branch ,\n\t\t Status ,\n\t\t DEALNO as DealNumber ,\n\t\t [Bought CCY] as BoughtCCY ,\n\t\t [Amount Bought] as AmountBought ,\n\t\t [Sold CCY] as SoldCCY ,\n\t\t [Amount Sold] as AmountSold ,\n\t\t SENDERREF as SENDERREF ,\n\t\t DEALDATE ,\n\t\t CUSTBIC as CUSTBIC ,\n\t\t [Customer Name] as CustomerName ,\n\t\t ValueDate ,\n\t\t Age ,\n\t\t SettlementAmount ,\n\t\t Getdate() as LoadDate,\n         \t\t CAST(DATEADD(DAY, CASE DATENAME(WEEKDAY, GETDATE()) \n                    WHEN 'Sunday' THEN -2\n                    WHEN 'Monday' THEN -3\n                    ELSE -1 END, DATEDIFF(DAY, -0, GETDATE())) AS date) as ReportDate \n from [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_MT300C_Report]\n WHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date);",
                "type" : "Expression"
              }
            } ],
