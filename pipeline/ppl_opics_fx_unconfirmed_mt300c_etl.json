              "type" : "NonQuery",
              "text" : {
                "value" : "UPDATE [ReconControl].dbo.tbl_Opics_FX_UnconfirmedCLS_MT300C_Report\nSET TotalConfirmation = (\n    SELECT COUNT(*)\n    FROM [ReconControl].dbo.tbl_Opics_FX_UnconfirmedCLS_MT300C_Report\n    WHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date)\n)\nWHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date);\n\n\nUPDATE [ReconControl].dbo.tbl_Opics_FX_UnconfirmedCLS_MT300C_Report\nSET Age = TRY_CAST(CAST([Trade Date Aging]  AS DECIMAL(18,2)) AS bigINT) \nWHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date);\n\nUPDATE rc\nSET SettlementAmount =\n    TRY_CAST(replace([Amount Sold],',','') AS decimal(18,4))  *\n    TRY_CAST(Rate AS decimal(18,4))\nFROM [ReconControl].dbo.tbl_Opics_FX_UnconfirmedCLS_MT300C_Report rc\nWHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date)\n  AND TRY_CAST(replace([Amount Sold],',','') AS decimal(18,4))  IS NOT NULL\n  AND TRY_CAST(Rate AS decimal(18,4)) IS NOT NULL;",
                "type" : "Expression"
              }
            } ],
            "scriptBlockExecutionTimeout" : null
