            "value" : "UPDATE ReconControl.[dbo].[tbl_Calypso_Mandatory_Clearing_Compliance_Aging]\nSET\nAge = v.Age,AgeDate=cast(getdate() as date)\nFROM ReconControl.[dbo].[tbl_Calypso_Mandatory_Clearing_Compliance_Aging] a\ninner join \n(\nselect [Trade Id]\n,MAX(age) as Age FROM\n(\n   SELECT distinct [Trade Id],FileDate,\n   [Utility].[dbo].[fn_BusinessDayCount] (FileDate,cast(getdate()as date)) as Age\n   FROM ReconControl.[dbo].[tbl_Calypso_Mandatory_Clearing_Compliance_Aging]  with(nolock)\n   )X group by [Trade Id] \n) v\n   ON a.[Trade Id]= v.[Trade Id];\n\nDelete from x from\n(\nselect  [Trade Id],FileDate,Loaddate,ROW_NUMBER() over (Partition by [Trade Id]--,FileDate,Loaddate\n Order by  [Trade Id],FileDate,Loaddate\n) as 'Rownumber' from ReconControl.dbo.tbl_Calypso_Mandatory_Clearing_Compliance_Aging\n--where cast(LoadDate as date) = cast(getdate() as date)\n)x\nwhere Rownumber >1",
            "type" : "Expression"
