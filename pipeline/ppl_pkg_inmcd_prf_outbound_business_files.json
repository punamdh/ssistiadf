                      "text" : "INSERT INTO AGP.PRF_CALC_OUT_MAP_MANUAL_INFO\n(\n\tBATCH_ID,\n\tRECORD_TYPE,\n\tRID,\n\tBENEFIT_PER_EFF_DT,\n\tBENEFIT_PER_TERM_DT,\n\tMCE_EFF_DT,\n\tMCE_TERM_DT,\n\tMONTHS_MEM_INCURRED,\n\tMONTHS_ARREARS,\n\tINCURRED_MONTH_REMAINING,\n\tLAST_PAC_AMT,\n\tSTATE_PAC_FUNDED,\n\tMEM_PAY_PRIOR_MCE,\n\tMEM_ROLLOVER_DISC_AMT,\n\tSTATE_DISC_PERCENTAGE,\n\tSTATE_ROLLOVER_DISC_AMT,\n\tTOTAL_ROLLOVER_DISC_AMT,\n\tMEM_OVERPAYMENTS,\n\tMEM_ACT_CASH_PAY,\n\tSTATE_CONTRIBUTION,\n\tMEM_REQ_CONT_ENROLLED,\n\tMEM_ROLLOVER_PAY_APPLIED,\n\tMEM_PAYMENTS,\n\tSTATE_DISCOUNT_AMT,\n\tSTATE_PAC_FUNDED_BALANCE,\n\tMEM_CLAIMS_PAID_BY_MCE,\n\tSTATE_CLAIMS_PAID_BY_MCE,\n\tTOTAL_CLAIMS_PAID_BY_MCE,\n\tMEM_PENALTY,\n\tMEM_REFUND_AMT,\n\tSTATE_PAC_REFUND_AMT,\n\tTOTAL_REFUND_WITH_PEN_AMT,\n\tMEM_UNFUNDED_DEBT_CMSCAP,\n\tPREVENTATIVE_SERVICES_FLAG,\n\tMEM_STATE_RECOUP_ROLLOVER,\n\tMEM_PRIOR_YEAR_DISC_REFUND,\n\tSTATE_PRIOR_YEAR_DISC_REFUND,\n\tMEM_ROLLOVER_PAID_PRIOR_MCE,\n\tMEM_OVERPAY_BY_DISCOUNT,\n\tDEBT_COLL_PRIOR_DEBT,\n\tSTATE_ROLLOVER_PAID_PRIOR_MCE,\n\tMEM_PRIOR_YEAR_DISC_AMT,\n\tSTATE_PRIOR_YEAR_DISC_AMT,\n\tMEM_DEBT\n)\nSELECT  /*+parallel(4)+*/\n        @BATCH_ID_Final,\n        TRIM(RECORD_TYPE),             \n        TRIM(RID),\n        TO_DATE(BENEFIT_PER_EFF_DT,'yyyy/mm/dd') AS BENEFIT_PER_EFF_DT,      \n        TO_DATE(BENEFIT_PER_TERM_DT,'yyyy/mm/dd') AS BENEFIT_PER_TERM_DT,  \n        TO_DATE(MCE_EFF_DT,'yyyy/mm/dd') AS MCE_EFF_DT,      \n        TO_DATE(MCE_TERM_DT,'yyyy/mm/dd') AS MCE_TERM_DT,        \n        CAST(MONTHS_MEM_INCURRED AS NUMBER) AS MONTHS_MEM_INCURRED,  \n        CAST(MONTHS_ARREARS AS NUMBER) AS MONTHS_ARREARS, \n        CAST(INCURRED_MONTH_REMAINING AS NUMBER) AS INCURRED_MONTH_REMAINING,\n        CAST(LAST_PAC_AMT AS NUMBER) AS LAST_PAC_AMT,\n        CAST(STATE_PAC_FUNDED AS NUMBER) AS STATE_PAC_FUNDED,\n        CAST(MEM_PAY_PRIOR_MCE AS NUMBER) AS MEM_PAY_PRIOR_MCE,\n        CAST(MEM_ROLLOVER_DISC_AMT AS NUMBER) AS MEM_ROLLOVER_DISC_AMT,        \n        CAST(STATE_DISC_PERCENTAGE AS NUMBER) AS STATE_DISC_PERCENTAGE,     \n        CAST(STATE_ROLLOVER_DISC_AMT AS NUMBER) AS STATE_ROLLOVER_DISC_AMT,\n        CAST(TOTAL_ROLLOVER_DISC_AMT AS NUMBER) AS TOTAL_ROLLOVER_DISC_AMT ,\n        CAST(MEM_OVERPAYMENTS AS NUMBER) AS MEM_OVERPAYMENTS,\n        CAST(MEM_ACT_CASH_PAY AS NUMBER) AS MEM_ACT_CASH_PAY,\n        CAST(STATE_CONTRIBUTION AS NUMBER) AS STATE_CONTRIBUTION,\n        CAST(MEM_REQ_CONT_ENROLLED AS NUMBER) AS MEM_REQ_CONT_ENROLLED,        \n        CAST(MEM_ROLLOVER_PAY_APPLIED AS NUMBER) AS MEM_ROLLOVER_PAY_APPLIED,   \n        CAST(MEM_PAYMENTS AS NUMBER) AS MEM_PAYMENTS,                                   \n        CAST(STATE_DISCOUNT_AMT AS NUMBER) AS STATE_DISCOUNT_AMT,\n        CAST(STATE_PAC_FUNDED_BALANCE AS NUMBER) AS STATE_PAC_FUNDED_BALANCE ,\n        CAST(MEM_CLAIMS_PAID_BY_MCE AS NUMBER) AS MEM_CLAIMS_PAID_BY_MCE,\n        CAST(STATE_CLAIMS_PAID_BY_MCE AS NUMBER) AS STATE_CLAIMS_PAID_BY_MCE,\n        CAST(TOTAL_CLAIMS_PAID_BY_MCE AS NUMBER) AS TOTAL_CLAIMS_PAID_BY_MCE,\n        CAST(MEM_PENALTY AS NUMBER) AS MEM_PENALTY,\n        CAST(MEM_REFUND_AMT AS NUMBER) AS MEM_REFUND_AMT,\n        CAST(STATE_PAC_REFUND_AMT AS NUMBER) AS STATE_PAC_REFUND_AMT,\n        CAST(TOTAL_REFUND_WITH_PEN_AMT AS NUMBER) AS TOTAL_REFUND_WITH_PEN_AMT,\n        CAST(MEM_UNFUNDED_DEBT_CMSCAP AS NUMBER) AS MEM_UNFUNDED_DEBT_CMSCAP,                      \n        LTRIM(RTRIM(PREVENTATIVE_SERVICES_FLAG)),   \n        CAST(MEM_STATE_RECOUP_ROLLOVER AS NUMBER) AS MEM_STATE_RECOUP_ROLLOVER,\n        CAST(MEM_PRIOR_YEAR_DISC_REFUND AS NUMBER) AS MEM_PRIOR_YEAR_DISC_REFUND , \n        CAST(STATE_PRIOR_YEAR_DISC_REFUND AS NUMBER) AS STATE_PRIOR_YEAR_DISC_REFUND,\n        CAST(MEM_ROLLOVER_PAID_PRIOR_MCE AS NUMBER) AS MEM_ROLLOVER_PAID_PRIOR_MCE,\n        CAST(MEM_OVERPAY_BY_DISCOUNT AS NUMBER) AS MEM_OVERPAY_BY_DISCOUNT,\n        CAST(DEBT_COLL_PRIOR_DEBT AS NUMBER) AS DEBT_COLL_PRIOR_DEBT,\n        CAST(STATE_ROLLOVER_PAID_PRIOR_MCE AS NUMBER) AS STATE_ROLLOVER_PAID_PRIOR_MCE,\n        CAST(MEM_PRIOR_YEAR_DISC_AMT AS NUMBER) AS MEM_PRIOR_YEAR_DISC_AMT,\n        CAST(STATE_PRIOR_YEAR_DISC_AMT AS NUMBER) AS STATE_PRIOR_YEAR_DISC_AMT,\n        CAST(MEM_DEBT AS NUMBER) AS MEM_DEBT    \nFROM AGP.PRF_OUT_FILE_STAGE_MAN_INFO"
