        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "INSERT INTO [Reconcontrol].[dbo].[tbl_Catalyst_Unallocated_EOD_Trades]\n([loadDate]\n      ,[entry_time]\n      ,[trade_date]\n      ,[settle_date]\n      ,[import_source]\n      ,[catalyst_trade_number]\n      ,[salesperson]\n      ,[counterparty]\n      ,[buy_sell]\n      ,[security_description]\n      ,[current_par]\n      ,[principal]\n      ,[accrued_interest]\n      ,[total_cash]\n      ,[currency]\n      ,[isin]\n      ,[cusip]\n      ,[price]\n      ,[aging]\n      ,[legal_entity]\n      ,[productType]\n      ,[inventory]\n      ,[deskName]\n      ,[tradingUnitName] \n\t)\nSELECT a.[loadDate]\n      ,a.[entry_time]\n      ,a.[trade_date]\n      ,a.[settle_date]\n      ,a.[import_source]\n      ,a.[catalyst_trade_number]\n      ,a.[salesperson]\n      ,a.[counterparty]\n      ,a.[buy_sell]\n      ,a.[security_description]\n      ,a.[current_par]\n      ,a.[principal]\n      ,a.[accrued_interest]\n      ,a.[total_cash]\n      ,a.[currency]\n      ,a.[isin]\n      ,a.[cusip]\n      ,a.[price]\n      ,a.[aging]\n      ,a.[legal_entity]\n      ,a.[productType]\n      ,a.[inventory]\n      ,a.[deskName]\n      ,a.[tradingUnitName]\nFROM [Reconcontrol].[dbo].[tbl_Catalyst_Unallocated_EOD_Trades_Staging] a\nLEFT OUTER JOIN [Reconcontrol].[dbo].[tbl_Catalyst_Unallocated_EOD_Trades] b ON CAST(a.loadDate as Date) = CAST(b.loadDate as Date)\nWHERE a.trade_state IS NULL\nAND CAST(b.loadDate as Date) IS NULL\n",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
