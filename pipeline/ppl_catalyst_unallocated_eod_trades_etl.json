      "name" : "ST_Execute_SQL_Task_-_Logic_for_Aging_and_Suballoc",
      "type" : "Script",
      "policy" : null,
      "dependsOn" : [ {
        "activity" : "SETVAR_nActualRows",
        "dependencyConditions" : [ "Succeeded" ]
      } ],
      "state" : null,
      "description" : null,
      "onInactiveMarkAs" : null,
      "linkedServiceName" : {
        "referenceName" : "OLEDB_MSOLEDBSQL_1_2",
        "type" : "LinkedServiceReference"
      },
      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "\n--Existing Trades - Suballocated\n\nWITH SubAllocated\nAS\n(\n\tSELECT distinct a.catalyst_trade_number, CAST(b.effective_date as Date) as effective_date, b.trade_state\n\tFROM [ReconControl].[dbo].[tbl_Catalyst_Unallocated_EOD_Trades_Staging] a\n\tLEFT JOIN [ReconControl].[dbo].[tbl_Catalyst_Trade] b \n\tON a.catalyst_trade_number = b.parent_trade_number\n\tWHERE b.trade_state in ('SUBALLOCATED','CONFIRMED', 'CANCELLED')\n\tAND a.trade_state IS NULL\n\n\n\tUNION\n\n\tSELECT distinct a.catalyst_trade_number, CAST(b.effective_date as Date) as effective_date, b.trade_state\n\tFROM [ReconControl].[dbo].[tbl_Catalyst_Unallocated_EOD_Trades_Staging] a\n\tLEFT JOIN [ReconControl].[dbo].[tbl_Catalyst_Trade] b \n\tON a.catalyst_trade_number = b.prev_trade_number\n\tWHERE b.trade_state  in ('SUBALLOCATED','CONFIRMED','CANCELLED')\n\tAND a.trade_state IS NULL\n\n\tUNION\n\n\tSELECT distinct a.catalyst_trade_number, CAST(b.effective_date as Date) as effective_date, b.trade_state\n\tFROM [ReconControl].[dbo].[tbl_Catalyst_Unallocated_EOD_Trades_Staging] a\n\tLEFT JOIN [ReconControl].[dbo].[tbl_Catalyst_Trade] b \n\tON a.catalyst_trade_number = b.catalyst_trade_number\n\tWHERE b.trade_status  in ('CNCL')\n\tAND a.trade_state IS NULL\n\n)\n\n\nUpdate A\nSET A.trade_state = B.trade_state \n       ,A.allocatedDate = CAST(B.effective_date as Date)\nFrom  [ReconControl].[dbo].[tbl_Catalyst_Unallocated_EOD_Trades_Staging] A\nINNER JOIN SubAllocated B\nON A.Catalyst_trade_number = B.catalyst_trade_number;\n\n\n\n--Existing Trades - Aging\n\nUPDATE A\nSET A.aging = DATEDIFF(d, A.entry_time, CAST(GETDATE() as Date))\n  FROM [ReconControl].[dbo].[tbl_Catalyst_Unallocated_EOD_Trades_Staging] A",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
    }, {
