                "value" : "update [ReconControl].[dbo].[tbl_Catalyst_Active_Trades]\nset entered_by_id = case when entered_by_id is null and trade_type = 'TRADER_TRADER' then trader_id \nwhen entered_by_id is null and trade_type = 'SALES_TRADER' then sales_person_id\nwhen entered_by_id is null and trade_type = 'CUSTOMER' then trader_id\nelse entered_by_id end\nfrom [ReconControl].[dbo].[tbl_Catalyst_Active_Trades]",
