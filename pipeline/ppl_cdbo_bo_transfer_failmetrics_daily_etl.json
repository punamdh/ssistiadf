        "referenceName" : "OLEDB_SQLNCLI11_1",
        "type" : "LinkedServiceReference"
      },
      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "\nInsert into [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] \nselect\ncast(CAPTURE_DATE as date) as [Report_Date],\n--cast(PRODUCT_ID as varchar)+''+cast(TRANSFER_ID as varchar)+''+cast(TRADE_ID as varchar)+''+cast(Aged as varchar) +''+cast(replace([CAPTURE_DATE],'/','')as varchar) as MapKey,\nCAPTURE_DATE,\nCAPTURE_TIME,\nTRANSFER_ID,\nEVENT_TYPE,\nTRANSFER_STATUS,\nTRADE_ID,\nPRODUCT_ID,\nPRODUCT_FAMILY,\nPRODUCT_TYPE,\nPRODUCT_SUBTYPE,\nTRANSFER_TYPE,\nAMOUNT,\nConverted_Amount,\nAMOUNT_CCY,\nTRADE_CCY,\nPAYRECEIVE_TYPE,\nVALUE_DATE,\ncast (SETTLE_DATE as date) as SETTLE_DATE,\nAged,\nEXT_LE_ID,\nEXT_LE_ROLE,\nEXT_SDI,\nEXT_AGENT_LE_ID,\nEXT_SDI_STATUS,\nINT_LE_ID,\nINT_LE_ROLE,\nINT_SDI,\nINT_AGENT_LE_ID,\nINT_SDI_STATUS,\nGL_ACCOUNT_ID,\nNETTING_KEY,\nDELIVERY_TYPE,\nSTART_TIME_LIMIT,\nOTHER_AMOUNT,\nBOOK_ID,\nAVAILABLE,\nTRADE_DATE,\nNETTED_TRANSFER,\nNETTED_TRANSFER_ID,\nBUNDLE_ID,\nXFER_ACTION,\nREAL_SETTLE_AMOUNT,\nIS_KNOWN,\nSETTLEMENT_METHOD,\nIS_FIXED,\nIS_RETURN,\nIS_PAYMENT,\nCASH_ACCOUNT_ID,\nAVAIL_DATE,\nINT_CASH_SDI,\nEXT_CASH_SDI,\nREAL_CASH_AMOUNT,\nLINKED_ID,\nDESCRIPTION,\nORIG_CPTY_ID,\nMANUAL_SDI,\nMANUAL_CASH_SDI,\nTRADE_VERSION,\nINT_SDI_VERSION,\nEXT_SDI_VERSION,\nNOMINAL_AMOUNT,\nVERSION_NUM,\nNETTED_TRADE_ID,\nBOOKING_DATE,\nCALLABLE_DATE,\nBUSINESSTYPE,\nFront_Office_ID,\nSHORT_NAME,\nLONG_NAME,\nLoadDate,\n'Fails' as [STATUS],\n'' as [FailsAged>3days] ,\n'' as [Fails>5MUSDe],\n'' as [TotalFails] ,\n'' as [TotalSettlements] \nfrom [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fail] with (nolock)\nwhere cast(CAPTURE_DATE as date) =cast(getdate() as date)\n;\n\n\n\nUPDATE  F\nSET F.[FailsAged>3days] = agg.[FailsAged>3days]\nFrom [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] F\nJOIN (\n    SELECT [CAPTURE_DATE],\n Count(Aged) AS [FailsAged>3days]\n    FROM [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results]\n where Aged >3 and [STATUS] ='Fails' and cast(CAPTURE_DATE as date)=cast(getdate() as date)\n    GROUP BY [CAPTURE_DATE]\n )agg on agg.[CAPTURE_DATE]=F.[CAPTURE_DATE];\n\n\nUPDATE  F\nSET F.[Fails>5MUSDe] = agg.[Fails>5MUSDe]\nFrom [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] F\nJOIN (\n    SELECT [CAPTURE_DATE],\n Count(Converted_Amount) AS [Fails>5MUSDe]\n    FROM [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results]\n where Converted_Amount >5000000 and  [STATUS] ='Fails' and cast(CAPTURE_DATE as date)=cast(getdate() as date)\n    GROUP BY [CAPTURE_DATE]\n )agg on agg.[CAPTURE_DATE]=F.[CAPTURE_DATE];\n\nUPDATE  F\nSET F.[TotalFails] = agg.[TotalFails]\nFrom [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] F\nJOIN (\n    SELECT [CAPTURE_DATE],\n Count([TotalFails]) AS [TotalFails]\n    FROM [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results]\n where   [STATUS] ='Fails' and cast(CAPTURE_DATE as date)=cast(getdate() as date)\n    GROUP BY [CAPTURE_DATE]\n )agg on agg.[CAPTURE_DATE]=F.[CAPTURE_DATE];\n\n\nUPDATE  F\nSET F.[TotalSettlements] = agg.[TotalSettlements]\nFrom [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] F\nJOIN (\n    SELECT [CAPTURE_DATE],\n Count(TRANSFER_ID) AS [TotalSettlements]\n    FROM [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results]\n where   [STATUS] ='Settlements' and cast(CAPTURE_DATE as date)=cast(getdate() as date)\n    GROUP BY [CAPTURE_DATE]\n )agg on agg.[CAPTURE_DATE]=F.[CAPTURE_DATE];\n\n\n\n",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
