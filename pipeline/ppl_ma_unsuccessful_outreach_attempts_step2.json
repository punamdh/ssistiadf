          "name" : "SQL_STATUS_UPDATE_DATA_PURGE_SCRIPT",
          "type" : "Script",
          "policy" : null,
          "dependsOn" : [ {
            "activity" : "DF_CPM_WB_FORM01",
            "dependencyConditions" : [ "Succeeded" ]
