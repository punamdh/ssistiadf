          },
          "typeProperties" : {
            "scripts" : [ {
              "type" : "Query",
              "text" : "\nUPDATE [APP_RPTS].[MA_HRA_CALLATTEMPTS]  SET STATUS ='C' FROM\n  (\n    SELECT \nCID,COUNT(TIMEADD) ATTEMPTCOUNT,TIMEADD FROM [APP_RPTS].[MA_HRA_CALLATTEMPTS]\nWHERE STATUS IS NULL\nGROUP BY TIMEADD,CID HAVING COUNT(TIMEADD)=3\n  ) CALLATTEMPTS WHERE [APP_RPTS].[MA_HRA_CALLATTEMPTS].TIMEADD = CALLATTEMPTS.TIMEADD\nAND [APP_RPTS].[MA_HRA_CALLATTEMPTS].CID = CALLATTEMPTS.CID\n\n\n\n;WITH PURGE AS  (\nSELECT CID,TIMEADD,UPDATE_DATE,COUNT(UPDATE_DATE) ATTEMPTCOUNT FROM  [APP_RPTS].[MA_HRA_CALLATTEMPTS]\nWHERE STATUS='C' AND DATEDIFF(DD,UPDATE_DATE,GETDATE())>5\nGROUP BY CID,TIMEADD,UPDATE_DATE\nHAVING COUNT(UPDATE_DATE)=3\n )\nDELETE MHC FROM [APP_RPTS].[MA_HRA_CALLATTEMPTS] MHC\nJOIN PURGE P ON MHC.CID=P.CID AND MHC.TIMEADD=P.TIMEADD AND MHC.UPDATE_DATE=P.UPDATE_DATE"
            } ],
            "scriptBlockExecutionTimeout" : null
          }
