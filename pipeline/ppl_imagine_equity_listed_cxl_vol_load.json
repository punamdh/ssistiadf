            "scripts" : [ {
              "type" : "NonQuery",
              "text" : {
                "value" : "insert into [ReconControl].dbo.tbl_imagine_equity_listed_metricsResults \nSELECT DISTINCT\n\t Try_Convert(Date, listed.ReportDate) AS [Report Date]\n\t,'LISTED' AS [ReportProduct]\n\t,listed.[Customer] \n\t,listed.[Customer Type] \n\t,ParentProductID = listed.ta_parent_product_id\n\t,HoldID = CONVERT(INT,listed.[Holding ID]) \n\t,TradeID = CONVERT(INT,listed.[Trade ID]) \n\t,Category = \n\t\tCASE \n\t\t\tWHEN listed.[QView Type] = 'CANCELLED/CHANGED' THEN 'CANCELLED/CHANGED'\n\t\t\tWHEN listed.[QView Type] = 'NEW' AND listed.[Transaction Type] = 'AS OF' THEN 'AS OF'\n\t\t\tELSE 'NEW'\n\t\tEND\n\t,listed.[Transaction Type] \n\t,listed.[QView Type] \n\t,ISNULL(listed.[Legal Entity], N'N/A') AS [Legal Entity]\n\t,listed.[Trade Date] \n\t,listed.[Settlement Date] \n\t,listed.[Buy/Sell] \n\t,listed.[Quantity] \n\t,listed.[Notional] \n\t,listed.[Trade Price] \n\t,listed.[Strike] \n\t,listed.[Type] \n\t,listed.[Underlyer] \n\t,listed.[P/C] \n\t,listed.[A/E] \n    ,CASE WHEN b.[TradeType] IS NULL AND [QView Type] = 'CANCELLED/CHANGED' THEN 'NOT AVAILABLE' ELSE ltrim(rtrim(b.[TradeType])) END AS [Changed Type]\n\t ,CASE WHEN b.[Comments] IS NULL AND [QView Type] = 'CANCELLED/CHANGED' THEN 'NOT AVAILABLE' ELSE b.[Comments] END as Comments\n\t,CASE WHEN b.[UserId] IS NULL AND [QView Type] = 'CANCELLED/CHANGED' THEN 'NOT AVAILABLE' ELSE b.[UserId] END AS [User]\n\t,CASE WHEN CAST(b.[LoadDate] AS VARCHAR(25)) IS NULL AND [QView Type] = 'CANCELLED/CHANGED' THEN 'NOT AVAILABLE' ELSE CAST(b.[LoadDate] AS VARCHAR(25)) END AS [Comment Load Date]\n\t,listed.[Strategy] \n\t,ISNULL(listed.Portfolio, N'N/A') AS Portfolio \n\t,listed.[Risk Group] \n\t,ISNULL(listed.DESK_NAME, N'UN-MAPPED') AS [DESK_NAME] \nfrom ReconControl.dbo.tbl_imagine_equity_listed_cancelNew_Details AS listed with (nolock) \nLEFT OUTER JOIN  ReconControl.dbo.tbl_imagine_equity_cancelreasons AS b with (nolock) ON CAST(listed.[Trade ID] AS varchar(100)) = CAST(b.tradeId AS varchar(100)) \nLEFT OUTER JOIN ReconControl.dbo.tbl_IM_GENERIC_ALLSTATUS AS C with (nolock)  ON listed.Portfolio = C.INVENTORY_NAME\nleft join [ReconControl].dbo.tbl_imagine_equity_listed_metricsResults   Results WITH (NOLOCK) on Results.[ReportDate] =cast(listed.[ReportDate] as date)\nand Results.TradeID=listed.[Trade ID]\nWHERE  Try_cast (listed.[ReportDate] as date) = DATEADD(DAY, CASE DATENAME(WEEKDAY, GETDATE()) \n                    WHEN 'Sunday' THEN -2 \n                    WHEN 'Monday' THEN -3 \n                    ELSE -1 END, DATEDIFF(DAY, 0, GETDATE()))\nAND listed.[Risk Group] <> 'ERR'\nand  ((listed.[QView Type] = 'NEW') AND (listed.[Days to Expiry] <> '0') OR\n                         (listed.[QView Type] <> 'NEW') OR\n                         (listed.Portfolio = 'EQSWAP.TEST'))\n\nand Results.TradeID is null\nand Results.[ReportDate] is null\n\n",
                "type" : "Expression"
              }
            } ],
            "scriptBlockExecutionTimeout" : null
          }
        } ],
        "isSequential" : true
