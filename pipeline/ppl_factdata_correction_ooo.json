      "Fact_Quey" : {
        "type" : "string",
        "defaultValue" : "'WITH mylead (dw_fact_key, dw_holder_key, dw_gate_key, iodatetime, iotime, iodate,\\n     iostatus, dw_run_key, dw_create_dt, dw_agg_key, validentryflag,\\n     lastupdate_dt, rowvers)\\n     AS (SELECT dw_fact_key,\\n                dw_holder_key,\\n                dw_gate_key,\\n                ( CONVERT(VARCHAR(10), iodate, 120) + ' ' +\\n                  CONVERT(VARCHAR, iotime, 108) ) AS\\n                iodatetime,\\n                iotime,\\n                iodate,\\n                iostatus,\\n                dw_run_key,\\n                dw_create_dt,\\n                dw_agg_key,\\n                validentryflag,\\n                lastupdate_dt,\\n                Row_number() OVER(PARTITION BY dw_holder_key,DW_AGG_KEY ORDER BY (CONVERT(VARCHAR(10),\\n                iodate, 120) + ' ' + CONVERT(VARCHAR, iotime, 108)) ASC) rowvers\\n         FROM   [Metadata_BI].[dbo].[FACT]\\n         WHERE  dw_run_key = 100 \\n                AND iostatus <> 'Invalid Door')\\nSELECT rowvers,\\n       employeename,\\n       reason,\\n       b.iodate                            AS o_iodate,\\n       b.iotime                            AS o_iotime,\\n       iodatetime,\\n       end_iodatetime,\\n       b.iostatus,\\n      a.iostatus as basestatus,\\n      a.leadstatus as leadstatus,\\n       dw_fact_key,\\n       a.dw_holder_key,\\n       dw_gate_key,\\n       a.dw_run_key,\\n       a.dw_create_dt,\\n       a.dw_agg_key,\\n       validentryflag,\\n       a.lastupdate_dt,\\n       \\n       COUNT(1) OVER(PARTITION BY rowvers) cnt\\nFROM   (SELECT base.dw_fact_key,\\n                          base.dw_holder_key,\\n                          base.dw_gate_key,\\n                          base.iodatetime,\\n                          base.iotime,\\n                          base.iodate,\\n                          base.iostatus,\\n                          lead.iostatus as leadstatus,\\n                          base.dw_run_key,\\n                          base.dw_create_dt,\\n                          base.dw_agg_key,\\n                          base.validentryflag,\\n                          base.lastupdate_dt,\\n                          Coalesce(lead.iodatetime, NULL) AS end_iodatetime,\\n                          base.rowvers\\n                   FROM   mylead base\\n                          LEFT JOIN mylead lead\\n                            ON BASE.DW_RUN_KEY = 100\\n                                                AND base.dw_holder_key = lead.dw_holder_key\\n                               AND base.dw_agg_key = lead.dw_agg_key\\n                               AND base.rowvers = lead.rowvers - 1\\n                               and BASE.ioSTATUS = LEAD.IOSTATUS\\n                         )a\\n        \\nINNER JOIN dim_holder DH\\n            ON a.dw_holder_key = DH.DW_HOLDER_KEY\\n            \\n      INNER JOIN oooioentry b\\n            on dh.holder_name = b.employeename\\n                and (CONVERT (datetime, ( CONVERT(VARCHAR(10), b.iodate, 120) + ' ' + CONVERT(VARCHAR, b.iotime, 108)))+1 >= a.iodatetime) \\n                AND (CONVERT (datetime,( CONVERT(VARCHAR(10), b.iodate, 120) + ' ' + CONVERT(VARCHAR, b.iotime, 108) ))+1< a.end_iodatetime)\\n            \\n       inner JOIN agg_fact af\\n         ON af.dw_agg_key = a.dw_agg_key\\n            AND isvalidentry = 1'"
