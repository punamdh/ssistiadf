          "sqlReaderStoredProcedureName" : null,
          "sqlReaderQuery" : "SELECT (SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OLEDB_Calypso_ContainerName' AND PIPELINE_NAME = 'ppl_calypsocreditcvatradecancelcorrect_fisnt' AND DATAFLOW_NAME = 'dft-load_mo_access_1') AS DFT-Load_MO_Access_1_OLEDBCalypso_ContainerName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OLEDB_Calypso_FileName' AND PIPELINE_NAME = 'ppl_calypsocreditcvatradecancelcorrect_fisnt' AND DATAFLOW_NAME = 'dft-load_mo_access_1') AS DFT-Load_MO_Access_1_OLEDBCalypso_FileName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OLEDB_Calypso_FilePath' AND PIPELINE_NAME = 'ppl_calypsocreditcvatradecancelcorrect_fisnt' AND DATAFLOW_NAME = 'dft-load_mo_access_1') AS DFT-Load_MO_Access_1_OLEDBCalypso_FilePath,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'to_OTCTRADEAUDITING_ContainerName' AND PIPELINE_NAME = 'ppl_calypsocreditcvatradecancelcorrect_fisnt' AND DATAFLOW_NAME = 'dft-load_mo_access_1') AS DFT-Load_MO_Access_1_toOTCTRADEAUDITING_ContainerName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'to_OTCTRADEAUDITING_FileName' AND PIPELINE_NAME = 'ppl_calypsocreditcvatradecancelcorrect_fisnt' AND DATAFLOW_NAME = 'dft-load_mo_access_1') AS DFT-Load_MO_Access_1_toOTCTRADEAUDITING_FileName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'to_OTCTRADEAUDITING_FilePath' AND PIPELINE_NAME = 'ppl_calypsocreditcvatradecancelcorrect_fisnt' AND DATAFLOW_NAME = 'dft-load_mo_access_1') AS DFT-Load_MO_Access_1_toOTCTRADEAUDITING_FilePath,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'DFT-Load_MO_Access_10_sink_SchemaName' AND PIPELINE_NAME = 'ppl_calypsocreditcvatradecancelcorrect_fisnt') AS DFT-Load_MO_Access_10_sink_SchemaName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'DFT-Load_MO_Access_10_sink_TableName' AND PIPELINE_NAME = 'ppl_calypsocreditcvatradecancelcorrect_fisnt') AS DFT-Load_MO_Ac