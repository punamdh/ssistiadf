          "typeProperties" : {
            "scripts" : [ {
              "type" : "Query",
              "text" : {
                "value" : "select FileNme, busGrp \nfrom\n(\nSelect ba.entity_id, b.book_name, tr.trade_status, trunc(modif_date) as amend_date, bav.attribute_name as crd_Book, modif_date,\ncase when bav.attribute_value = 'Investment Solutions' then 'PnlByTradeDetails_CRD_CVA_FISNT_'\nwhen bav.attribute_value = 'Fixed Income Structured Notes Trading' then 'PnlByTradeDetails_CRD_CVA_FISNT_'\n else 'NA' end as FileNme,\nCase when bav.attribute_value = 'Investment Solutions' then 'CVA_FISNT'\nwhen bav.attribute_value = 'Fixed Income Structured Notes Trading' then 'CVA_FISNT'\n else 'NA' end as busGrp\nfrom CALYPSODBA.BO_AUDIT ba INNER JOIN CALYPSODBA.TRADE tr ON tr.trade_id = ba.entity_id  inner join CALYPSODBA.BOOK_ATTR_VALUE bav on tr.book_id = bav.book_id\nINNER JOIN CALYPSODBA.BOOK b on b.book_id = tr.book_id\nwhere ba.entity_class_name = 'Trade'  \nand bav.attribute_value in('Investment Solutions', 'Fixed Income Structured Notes Trading')\nand ba.modif_date > = TRUNC(SYSDATE - 1, 'DD') and ba.Modif_date < TRUNC(SYSDATE, 'DD')\nand entity_id in \n(Select t.trade_id\nfrom CALYPSODBA.TRADE t\ninner join  CALYPSODBA.BOOK_ATTR_VALUE b on b.book_id = t.book_id\nWHERE ATTRIBUTE_VALUE in('Investment Solutions', 'Fixed Income Structured Notes Trading') and \nt.trade_status NOT in ('CH_AFFIRMED', 'CH_PENDING', 'CH_REJECT', 'CONSENT_PENDING', 'DAY_RECONCILED', 'DAY_TERM_ERROR', 'DAY_TERMINATED', \n'DAY_TRM_ERR_APRV', 'FCM_REJECT', 'FCM_REJECT_HOLD', 'FO_REVIEW_NPF', 'INVALID', 'MO_APPROVED', 'NC_CANCELED', 'NC_CONSENT_PEND', 'NC_PENDING', \n'PLACEHOLDER', 'PRICING', 'PRICING_MAT', 'RECONCILED', 'RISK_OTHER', 'SENT_TO_CH', 'HEDGE_TODAY', 'HEDGE_CLOSE', 'HEDGE_INTRAD')))\ngroup by FileNme, busGrp",
                "type" : "Expression"
              }
            } ],
            "scriptBlockExecutionTimeout" : null
