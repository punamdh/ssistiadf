      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "UPDATE a\nSET a.line1 = b.legalFullName\nFROM ReconControl.dbo.tbl_SLACP_counterparty_list a\n     LEFT JOIN ReconControl.dbo.tbl_SLACP_CID_Data b\n     ON a.contraParty = b.busAExtlKeyCLegal\nWHERE (a.line1 IS NULL OR a.line1= '')\n     AND b.busAExtlSystemC IN ('LOANET', 'G1');\n\nUPDATE a\nSET a.line1 = b.CustomerName\nFROM ReconControl.dbo.tbl_SLACP_counterparty_list a\n     LEFT JOIN ReconControl.dbo.tbl_SLACP_Broadridge_Box_Report_Import b\n     ON a.contraParty = b.CustomerNumber\nWHERE (a.line1 IS NULL OR a.line1= '')\n     AND (b.SourceSystemName LIKE 'LOANET%' OR b.SourceSystemName LIKE 'GlobalOne%');",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
