      "typeProperties" : {
        "variableName" : "gv_RCPTBLRCQuery",
        "value" : {
          "value" : "@concat('SELECT DISTINCT RCPT.RCPT_ID, RCPT.BLEI_CK, RCPT.RCPT_INPUT_GRGR_ID, RCPT.RCPT_INPUT_SBSB_ID, RCPT.RCPT_RCPT_CD, RCPT.RCPT_AMT, TRUNC (RCPT.RCPT_RCVD_DT) AS RCPT_RCVD_DT, TO_CHAR (RCPT.RCPT_CREATE_DTM, ''MM/DD/YYYY HH24:MI:SS'') AS RCPT_CREATE_DTM, BLRC.BLRC_SEQ_NO, BLRC.BLRC_AMT, TRUNC (BLRC.BLBL_DUE_DT) AS BLBL_DUE_DT, BLRC.BLRC_BLBL_PAID_STS, TO_CHAR (BLRC.BLRC_CREATE_DTM, ''MM/DD/YYYY HH24:MI:SS'') AS BLRC_CREATE_DTM FROM FACETS.CMC_GRGR_GROUP GRGR JOIN FACETS.CMC_SBSB_SUBSC SBSB ON GRGR.GRGR_CK = SBSB.GRGR_CK JOIN FACETS.CMC_BLEI_ENTY_INFO BLEI ON     SBSB.SBSB_CK = BLEI.BLEI_BILL_LEVEL_CK AND BLEI.BLEI_BILL_LEVEL = ''I'' AND BLEI.BLEI_SUSPND_BL_IND <> ''D'' JOIN FACETS.CMC_RCPT_RECEIPTS RCPT ON RCPT.BLEI_CK = BLEI.BLEI_CK AND RCPT.RCPT_RCPT_CD = ''W'' JOIN FACETS.CMC_BLRC_BILL_RCPT BLRC ON     BLRC.RCPT_ID = RCPT.RCPT_ID AND BLRC.BLEI_CK = RCPT.BLEI_CK AND BLRC.BLRC_SUSPENSE_IND = ''N'' AND BLRC.BLBL_DUE_DT >= TO_DATE (''', string(variables('gv_BLBLDueDt')), ''',''mm/dd/yyyy'') AND BLRC.BLBL_DUE_DT <= TO_DATE (''', string(variables('gv_BatchDate')), ''',''mm/dd/yyyy'')')",
