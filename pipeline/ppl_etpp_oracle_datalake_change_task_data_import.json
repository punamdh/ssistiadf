        "defaultValue" : "select   cr.change_request_number as request_number ,tsk.change_task_number ,tsk.priority_description as task_priority_description   ,tsk.closed_at as task_closed_at   ,tsk.closed_by_name as task_closed_by   ,task.ci_item_name ,task.ci_item_guid ,cr.start_date ,cr.end_date ,tsk.assignment_group_name ,tsk.assigned_to_name ,tsk.change_task_type ,tsk.todsh_business_effective_date ,Null AS SUB_TYPE_CODE   FROM ITM_CURATED.CHANGE_REQUEST CR  LEFT JOIN ITM_CURATED.CHANGE_TASK TSK \tON TSK.CHANGE_REQUEST_NUMBER=CR.CHANGE_REQUEST_NUMBER RIGHT JOIN ITM_CURATED.ITMP_GROUP_HIERARCHY GH \tON CR.ASSIGNMENT_GROUP_NAME=GH.NAME INNER JOIN ITM_CURATED.TASK_RELATED_CI_AFFECTED TASK     ON TASK.TASK_NUMBER = TSK.CHANGE_TASK_NUMBER where (cr.state_description not in ('CANCELED') OR cr.SYS_UPDATED_ON >= sysdate -5) AND (    CR.ASSIGNMENT_GROUP_NAME in ( 'DISP WEC EXIT- V2V MIGRATION','DCMS WEC EXIT - V2V MIGRATION','DISP WEC EXIT- LIFT/SHIFT','DCMS-HCX MIGRATIONS','DCMS DC EXIT & MIGRATION – DB','DCMS VIRT OPS') OR cr.short_description like 'INFRASTRUCTURE DECOMMISSION%' OR ( cr.assignment_group_name = 'IAT-ETPPSUPPORT' AND ( cr.short_description like 'DCMS V2V - CUTOVER VMS%'  OR cr.short_description like 'DISP%ESX%EOVS%%CUTOVER%' ) )   OR cr.REASON = 'DCMS' OR cr.short_description like '%OCP/TECH%ENABLEMENT%')  AND cr.SYS_UPDATED_ON >= TO_DATE('01-01-2022', 'MM-DD-YYYY')"
