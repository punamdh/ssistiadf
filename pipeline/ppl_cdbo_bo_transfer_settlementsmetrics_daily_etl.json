      "name" : "ST_Update_Result_table_0",
      "type" : "Script",
      "policy" : null,
      "dependsOn" : [ {
        "activity" : "ST_Load_Results_0",
        "dependencyConditions" : [ "Succeeded" ]
      } ],
      "state" : null,
      "description" : null,
      "onInactiveMarkAs" : null,
      "linkedServiceName" : {
        "referenceName" : "OLEDB_SQLNCLI11_1",
        "type" : "LinkedServiceReference"
      },
      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "\n\nUPDATE  F SET F.[FailsAged>3days] = agg.[FailsAged>3days] From [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] F JOIN (     SELECT [CAPTURE_DATE],Report_Date,  Count(Aged) AS [FailsAged>3days]     FROM [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results]  where Aged >3 and [STATUS] ='Fails' and cast(CAPTURE_DATE as date)=cast(getdate()-1 as date)     GROUP BY [CAPTURE_DATE],Report_Date  )agg on agg.Report_Date=F.Report_Date;   UPDATE  F SET F.[Fails>5MUSDe] = agg.[Fails>5MUSDe] From [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] F JOIN (     SELECT [CAPTURE_DATE],Report_Date,  Count(Converted_Amount) AS [Fails>5MUSDe]     FROM [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results]  where Converted_Amount >5000000 and  [STATUS] ='Fails' and cast(CAPTURE_DATE as date)=cast(getdate()-1 as date)     GROUP BY [CAPTURE_DATE],Report_Date  )agg on agg.Report_Date=F.Report_Date;  UPDATE  F SET F.[TotalFails] = agg.[TotalFails] From [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] F JOIN (     SELECT [CAPTURE_DATE],Report_Date,  Count([TotalFails]) AS [TotalFails]     FROM [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results]  where   [STATUS] ='Fails' and cast(CAPTURE_DATE as date)=cast(getdate()-1 as date)     GROUP BY [CAPTURE_DATE],Report_Date  )agg on agg.Report_Date=F.Report_Date;    UPDATE  F SET F.[TotalSettlements] = agg.[TotalSettlements] From [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] F JOIN (     SELECT [CAPTURE_DATE],Report_Date,  Count(TRANSFER_ID) AS [TotalSettlements]     FROM [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results]  where   [STATUS] ='Settlements' and cast(CAPTURE_DATE as date)=cast(getdate() as date)     GROUP BY [CAPTURE_DATE],Report_Date  )agg on agg.Report_Date=F.Report_Date;\n\n\n\n\n",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
