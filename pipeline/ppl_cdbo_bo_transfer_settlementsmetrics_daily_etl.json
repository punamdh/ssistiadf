        "type" : "LinkedServiceReference"
      },
      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "\nUPDATE [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Settlements]\nSET\nAged = v.Aged\nFROM [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Settlements] a\ninner join \n(\n   SELECT Transfer_ID,Product_ID,\n   ReconControl.[dbo].[fn_BusinessDayCount] (VALUE_DATE,CAPTURE_DATE)-1 as Aged,\n   VALUE_DATE,\n   CAPTURE_DATE\n   FROM \n   [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Settlements] with(nolock)\n   where LoadDate=cast(getdate() as date)\n) v\n   ON a.Transfer_ID= v.Transfer_ID\n   and a.Product_ID=v.Product_ID\n   and a.VALUE_DATE=v.VALUE_DATE\n   and a.CAPTURE_DATE=v.CAPTURE_DATE\n   where a.LoadDate=cast(getdate() as date)",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
    }, {
      "name" : "ST_Load_Results_0",
      "type" : "Script",
      "policy" : null,
      "dependsOn" : [ {
        "activity" : "ST_Age_Calculation_0",
        "dependencyConditions" : [ "Succeeded" ]
      } ],
      "state" : null,
      "description" : null,
