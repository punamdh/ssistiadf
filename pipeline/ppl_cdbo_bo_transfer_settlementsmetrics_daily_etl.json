      "linkedServiceName" : {
        "referenceName" : "OLEDB_SQLNCLI11_1",
        "type" : "LinkedServiceReference"
      },
      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "Insert into [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Fails_Settlements_Results] \nselect\ncast(VALUE_DATE as date) as [Report_Date],\n--cast(PRODUCT_ID as varchar)+''+cast(TRANSFER_ID as varchar)+''+cast(TRADE_ID as varchar)+''+cast(Aged as varchar) +''+cast(replace([CAPTURE_DATE],'/','')as varchar) as MapKey,\nCAPTURE_DATE,\nCAPTURE_TIME,\nTRANSFER_ID,\nEVENT_TYPE,\nTRANSFER_STATUS,\nTRADE_ID,\nPRODUCT_ID,\nPRODUCT_FAMILY,\nPRODUCT_TYPE,\nPRODUCT_SUBTYPE,\nTRANSFER_TYPE,\nAMOUNT,\nConverted_Amount,\nAMOUNT_CCY,\nTRADE_CCY,\nPAYRECEIVE_TYPE,\nVALUE_DATE,\ncast (SETTLE_DATE as date) as SETTLE_DATE,\nAged,\nEXT_LE_ID,\nEXT_LE_ROLE,\nEXT_SDI,\nEXT_AGENT_LE_ID,\nEXT_SDI_STATUS,\nINT_LE_ID,\nINT_LE_ROLE,\nINT_SDI,\nINT_AGENT_LE_ID,\nINT_SDI_STATUS,\nGL_ACCOUNT_ID,\nNETTING_KEY,\nDELIVERY_TYPE,\nSTART_TIME_LIMIT,\nOTHER_AMOUNT,\nBOOK_ID,\nAVAILABLE,\nTRADE_DATE,\nNETTED_TRANSFER,\nNETTED_TRANSFER_ID,\nBUNDLE_ID,\nXFER_ACTION,\nREAL_SETTLE_AMOUNT,\nIS_KNOWN,\nSETTLEMENT_METHOD,\nIS_FIXED,\nIS_RETURN,\nIS_PAYMENT,\nCASH_ACCOUNT_ID,\nAVAIL_DATE,\nINT_CASH_SDI,\nEXT_CASH_SDI,\nREAL_CASH_AMOUNT,\nLINKED_ID,\nDESCRIPTION,\nORIG_CPTY_ID,\nMANUAL_SDI,\nMANUAL_CASH_SDI,\nTRADE_VERSION,\nINT_SDI_VERSION,\nEXT_SDI_VERSION,\nNOMINAL_AMOUNT,\nVERSION_NUM,\nNETTED_TRADE_ID,\nBOOKING_DATE,\nCALLABLE_DATE,\nBUSINESSTYPE,\nFront_Office_ID,\nSHORT_NAME,\nLONG_NAME,\nLoadDate,\n'Settlements' as [STATUS],\n'' as [FailsAged>3days] ,\n'' as [Fails>5MUSDe],\n'' as [TotalFails] ,\n'' as [TotalSettlements] \nfrom [ReconControl].[dbo].[tbl_CDBO_BO_TRANSFER_Settlements] with (nolock)\nwhere cast(CAPTURE_DATE as date) =cast(getdate() as date)\nand \n(\n(BUSINESSTYPE='EQUITY'\nand TRANSFER_STATUS in ('CPNET_EQ_SETTLE','SETTLED')) \n\nor \n(BUSINESSTYPE='SCP'\nand TRANSFER_STATUS in ('CPNET_SETTLE','SETTLED','CLS_SETTLED'))\n\nor \n\n(BUSINESSTYPE='Commodity'\nand TRANSFER_STATUS in ('CPNET_SETTLE','CPNET_FAILED')) \nand SETTLEMENT_METHOD in (\n'ABA',\n'ACH',\n'BOOK_TRANSFER_W