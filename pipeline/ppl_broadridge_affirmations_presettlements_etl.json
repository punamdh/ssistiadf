          "name" : "ST_Execute_SQL_Task_-_Update_Affirmation_Rate_0",
          "type" : "Script",
          "policy" : null,
          "dependsOn" : [ {
            "activity" : "ST_Execute_SQL_Task_-_Insert_into_the_main_table_w",
