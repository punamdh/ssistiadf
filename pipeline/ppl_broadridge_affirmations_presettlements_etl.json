          "linkedServiceName" : {
            "referenceName" : "OLEDB_MSOLEDBSQL_1_2",
            "type" : "LinkedServiceReference"
          },
          "typeProperties" : {
            "scripts" : [ {
              "type" : "NonQuery",
              "text" : {
                "value" : "WITH Numerator\nAS\n(\n\tSELECT Trade_Date, Count(*) as AffirmedCount\n\tFROM [ReconControl].[dbo].[tbl_Broadridge_Affirmations_PreSettlements]\n\tWHERE affirmed = 'Yes'\n\tGROUP BY Trade_Date\n),\n\nDenominator\nAS\n(\n\tSELECT Trade_Date, Count(*) as TotalCount\n\tFROM [ReconControl].[dbo].[tbl_Broadridge_Affirmations_PreSettlements]\n\tGROUP BY Trade_Date\n)\n\nUPDATE a\nSET a.AffirmedCount = b.AffirmedCount\n\t,a.TotalCount =  c.TotalCount\n\t,a.AffirmationRate =  Round((Convert(Float,b.AffirmedCount)/Convert(Float,c.TotalCount)) * 100, 2)\nFROM [ReconControl].[dbo].[tbl_Broadridge_Affirmations_PreSettlements] a\nINNER JOIN Numerator b ON a.TRADE_DATE = b.TRADE_DATE\nINNER JOIN Denominator c on b.TRADE_DATE = c.TRADE_DATE\nWHERE a.AffirmationRate IS NULL",
                "type" : "Expression"
              }
            } ],
            "scriptBlockExecutionTimeout" : null
          }
        }, {
          "name" : "ST_Get_Actual_Fails_Rows_0",
          "type" : "Script",
          "policy" : null,
