            "scripts" : [ {
              "type" : "NonQuery",
              "text" : {
                "value" : "\n\nINSERT INTO [ReconControl].[dbo].[tbl_Broadridge_Affirmations_PreSettlements]\n(\t\n\t[loadDate],\n\t[CLIENT],\n\t[PRODUCT],\n\t[ACCOUNT_NUMBER],\n\t[TYPE],\n\t[Chk],\n\t[ACCOUNT_NAME] ,\n\t[CUSIP],\n\t[Symbol],\n\t[Quantity],\n\t[ORIGINAL_PRICE] ,\n\t[NET_AMOUNT],\n\t[DTC],\n\t[CUSTOMER_NUMBER],\n\t[MARKET_STATUS],\n\t[CageKey],\n\t[BuySell],\n\t[TRADE_DATE],\n\t[SETTLEMENT_DATE],\n\t[AFFIRMATION_DATE],\n\t[AFFIRMED],\n\t[IDControl],\n\t[Blotter],\n\t[INV],\n\t[BRRepID],\n\t[SALES_PERSON] ,\n\t[SALES_ASSISTANT] ,\n\t[SALES_MANAGER] ,\n\t[BACK_UP] ,\n\t[SALES_GROUP] ,\n\t[ADP_NUMBER],\n\t[Description] ,\n\t[TRADE_NUMBER],\n\t[IsCancel],\n\t[OFFSET],\n\t[Currency],\n\t[Origin],\n\t[CPNRATE] ,\n\t[LegalID],\n\t[LegalName],\n\t[COMMENTS] ,\n\t[CommentDate],\n\t[Commenter],\n\t[Reason] ,\n\t[BRRR],\n\t[DO_CLH_NBR],\n\t[CLIENT_CLNAME_PROD],\n\t[CounterParty] ,\n\t[POSITION_GROUP_DESCRIPTION] ,\n\t[SPIN],\n\t[AGENTINTACCOUNTNUMBER],\n\t[DTCAGENTBANKNUMBER],\n\t[DTCINSTID]\n)\nSELECT \n\ta.[loadDate],\n\ta.[CLIENT],\n\ta.[PRODUCT],\n\ta.[ACCOUNT_NUMBER],\n\ta.[TYPE],\n\ta.[Chk],\n\ta.[ACCOUNT_NAME] ,\n\ta.[CUSIP],\n\ta.[Symbol],\n\ta.[Quantity],\n\ta.[ORIGINAL_PRICE] ,\n\ta.[NET_AMOUNT],\n\ta.[DTC],\n\ta.[CUSTOMER_NUMBER],\n\ta.[MARKET_STATUS],\n\ta.[CageKey],\n\ta.[BuySell],\n\ta.[TRADE_DATE],\n\ta.[SETTLEMENT_DATE],\n\ta.[AFFIRMATION_DATE],\n\ta.[AFFIRMED],\n\ta.[IDControl],\n\ta.[Blotter],\n\ta.[INV],\n\ta.[BRRepID],\n\ta.[SALES_PERSON] ,\n\ta.[SALES_ASSISTANT] ,\n\ta.[SALES_MANAGER] ,\n\ta.[BACK_UP] ,\n\ta.[SALES_GROUP] ,\n\ta.[ADP_NUMBER],\n\ta.[Description] ,\n\ta.[TRADE_NUMBER],\n\ta.[IsCancel],\n\ta.[OFFSET],\n\ta.[Currency],\n\ta.[Origin],\n\ta.[CPNRATE] ,\n\ta.[LegalID],\n\ta.[LegalName],\n\ta.[COMMENTS] ,\n\ta.[CommentDate],\n\ta.[Commenter],\n\ta.[Reason] ,\n\ta.[BRRR],\n\ta.[DO_CLH_NBR],\n\ta.[CLIENT_CLNAME_PROD],\n\ta.[CounterParty] ,\n\ta.[POSITION_GROUP_DESCRIPTION] ,\n\ta.[SPIN],\n\ta.[AGENTINTACCOUNTNUMBER],\n\ta.[DTCAGENTBANKNUMBER],\n\ta.[DTCINSTID]\nFROM [ReconControl].[dbo].[tbl_Broadridge_Affirmations_PreSettlements_Staging] a\nLEFT OUTER JOIN [ReconControl].[dbo].[tbl_Broadridge_Affirmations_PreSettlements] b ON a.TRADE_DATE = b.TRADE_DATE\nWHERE ((a.IDControl is not null) and a.IDControl <> '') \nAND a.blotter not in ('6n','8n')\nAND b.TRADE_DATE IS NULL\n\n\n\n",
