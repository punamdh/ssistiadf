    "variables" : {
      "selectquery" : {
        "type" : "String",
        "defaultValue" : "select DISTINCT   cr.SYS_CLASS_NAME as SYS_CLASS_NAME  ,cr.change_request_number AS request_number  ,cia.ci_item_name as affected_CI  ,cr.requested_by_name  ,cr.type_column AS type_column  ,gh.parent AS parent_group  ,gh.name AS child_group_name  ,cr.cmdb_ci_name  ,cr.short_description  ,cr.impact_description AS impact_description  ,cr.opened_at AS opened_at  ,cr.SYS_UPDATED_BY  ,cr.SYS_UPDATED_ON  ,cr.state_description AS state_description  ,cr.priority_description AS priority_description  ,cr.START_DATE  ,cr.ASSIGNED_TO_NAME  ,cr.ASSIGNMENT_GROUP_GUID  ,cr.ASSIGNMENT_GROUP_NAME  ,cr.CATEGORY  ,cr.CI_CLASS  ,cr.END_DATE  ,cr.OPENED_BY_NAME  ,cr.PHASE  ,cr.PHASE_STATE  ,cr.REASON  ,cr.RISK_DESCRIPTION  ,cr.SCOPE_DESCRIPTION  ,cr.UPON_APPROVAL  ,cr.UPON_REJECT  ,cr.URGENCY_DESCRIPTION  ,cr.closed_at AS closed_at  ,cr.closed_by_name  ,cr.close_code  ,cia.CI_ITEM_GUID  from itm_curated.change_request cr  right join itm_curated.itmp_group_hierarchy gh  on cr.assignment_group_guid=gh.wf_guid  left join itm_curated.task_related_ci_affected cia  on cr.sys_id=cia.task_guid  join itm_curated.configuration_item_all crt  on crt.u_WF_GUID=cia.ci_item_guid  where (cr.state_description not in ('CANCELED') OR cr.SYS_UPDATED_ON >= sysdate -5) AND (    CR.ASSIGNMENT_GROUP_NAME in ( 'DISP WEC EXIT- V2V MIGRATION','DCMS WEC EXIT - V2V MIGRATION','DISP WEC EXIT- LIFT/SHIFT','DCMS-HCX MIGRATIONS','DCMS DC EXIT & MIGRATION – DB','DCMS VIRT OPS') OR cr.short_description like 'INFRASTRUCTURE DECOMMISSION%' OR ( cr.assignment_group_name = 'IAT-ETPPSUPPORT' AND ( cr.short_description like 'DCMS V2V - CUTOVER VMS%'  OR cr.short_description like 'DISP%ESX%EOVS%%CUTOVER%' ) )   OR cr.REASON = 'DCMS')  AND cr.SYS_UPDATED_ON >= TO_DATE('01-01-2022', 'MM-DD-YYYY')"
