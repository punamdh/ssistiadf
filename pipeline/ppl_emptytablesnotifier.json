      "typeProperties" : {
        "scripts" : [ {
          "type" : "Query",
          "text" : {
            "value" : "SELECT \n    CASE \n        WHEN COUNT(*) = 0 THEN NULL\n        ELSE \n            'The following critical tables are empty in:' + CHAR(13) + CHAR(10) +\n            CAST(SERVERPROPERTY('ServerName') AS NVARCHAR) + CHAR(13) + CHAR(10) +\n            '---------------------------------------------------------------------' + CHAR(13) + CHAR(10) +\n            STRING_AGG(TableName, CHAR(13) + CHAR(10))\n    END AS EmailBody\nFROM [dcm_dataloads].[EmptyTableStatus]\nWHERE Criticality = 'CRITICAL'\n  AND (LastNotifiedDate IS NULL OR LastNotifiedDate <= DATEADD(hour, -24, GETDATE()))\n  AND IsNotified = 0;",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
