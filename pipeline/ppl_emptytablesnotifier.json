            "type" : "LinkedServiceReference"
          },
          "typeProperties" : {
            "scripts" : [ {
              "type" : "NonQuery",
              "text" : {
                "value" : "-- After sending an email, update IsNotified and LastNotifiedDate for those tables\nUPDATE [dcm_dataloads].[EmptyTableStatus]\nSET IsNotified = 1,\n    LastNotifiedDate = GETDATE()\nWHERE Criticality = 'CRITICAL'\n  AND IsNotified = 0;\n\n-- Insert sent tables into the EmailNotificationLog after sending the email\nINSERT INTO [dcm_dataloads].[EmailNotificationLog](TableName, Criticality, SentDateTime)\nSELECT TableName, Criticality, GETDATE()\nFROM [dcm_dataloads].[EmptyTableStatus]\nWHERE Criticality = 'CRITICAL' AND IsNotified = 1 AND LastNotifiedDate = CAST(GETDATE() AS DATE);\n",
                "type" : "Expression"
              }
            } ],
            "scriptBlockExecutionTimeout" : null
          }
        }, {
          "name" : "ST_Get_Low-critical_Empty_Tables_0",
          "type" : "Script",
          "policy" : null,
          "dependsOn" : [ {
            "activity" : "ST_update_after_notify_0",
            "dependencyConditions" : [ "Succeeded" ]
          } ],
          "state" : null,
          "description" : null,
          "onInactiveMarkAs" : null,
          "linkedServiceName" : {
            "referenceName" : "OLEDB_MSOLEDBSQL_1",
            "type" : "LinkedServiceReference"
          },
          "typeProperties" : {
            "scripts" : [ {
              "type" : "Query",
              "text" : {
                "value" : "IF DATEPART(WEEKDAY, GETDATE()) = 2\nBEGIN\n    SELECT \n        CASE \n            WHEN COUNT(*) = 0 THEN NULL\n            ELSE \n                'The following Low-Critical tables are empty in:' + CHAR(13) + CHAR(10) +\n                CAST(SERVERPROPERTY('ServerName') AS NVARCHAR) + CHAR(13) + CHAR(10) +\n                '---------------------------------------------------------------------' + CHAR(13) + CHAR(10) +\n                STRING_AGG(TableName, CHAR(13) + CHAR(10))\n        END AS EmailBodyWeekly\n    FROM [dcm_dataloads].[EmptyTableStatus]\n    WHERE Criticality = 'Low_Critical' AND IsNotified = 0;\nEND\nELSE\nBEGIN\n    SELECT NULL AS EmailBodyWeekly;\nEND",
                "type" : "Expression"
              }
            } ],
            "scriptBlockExecutionTimeout" : null
          }
        }, {
          "name" : "SETVAR_EmailBodyWeekly",
          "type" : "SetVariable",
          "policy" : {
