          "typeProperties" : {
            "scripts" : [ {
              "type" : "NonQuery",
              "text" : {
                "value" : "DELETE FROM tlkp_AccessZones;\n\nINSERT INTO tlkp_AccessZones\n(\n    DatacenterAlias,\n    ZoneName\n)\nSELECT\n    k.DatacenterAlias,\n    LTRIM(RTRIM(s.value)) AS ZoneName\nFROM ksladmin_tbx k\nCROSS APPLY STRING_SPLIT(\n    REPLACE(k.AccessArea, CHAR(13), ''),\n    CHAR(10)\n) s\nWHERE k.SiteStatus = 'Active'\n  AND LTRIM(RTRIM(s.value)) <> ''\n  AND LTRIM(RTRIM(s.value)) NOT IN ('null', 'None');",
                "type" : "Expression"
              }
            } ],
            "scriptBlockExecutionTimeout" : null
          }
        }, {
          "name" : "ST_Execute_SQL_steps_0",
          "type" : "Script",
          "policy" : null,
          "dependsOn" : [ {
            "activity" : "ST_Populate_tlkp_AccessZones_0",
            "dependencyConditions" : [ "Succeeded" ]
          } ],
          "state" : null,
          "description" : null,
          "onInactiveMarkAs" : null,
          "linkedServiceName" : {
            "referenceName" : "OLEDB_SQLOLEDB_1",
            "type" : "LinkedServiceReference"
          },
          "typeProperties" : {
            "scripts" : [ {
              "type" : "NonQuery",
              "text" : {
                "value" : "--Insert all related zones data to acztotal based on matching between acztotal and tlkp_accesszones (ksladmin_tbx)\n\nINSERT INTO [dcm_dataloads].[acztotal]\n(\n    [ZONE_NAME],[ZONE_VALID_FROM],[ZONE_VALID_TO],[FIRSTNAME],[LASTNAME],[EID],[ELID],[EMAIL],[JOBTITLE]\n           ,[AVAILABLE_TO_WORK],[HIRE_DATE],[EXPECTEDENDDATE], [ZONEOWNEREMAIL], [VENDOR_COMPANY]\n           ,[MANAGER_FIRST_NAME],[MANAGER_LASTNAME],[MANAGER_EMAIL],[MANAGER_NAME]\n           ,[ACCESS_KEEPER_ID],[SiteAlias],[UploadDate],[ETLUser]\n)\nSELECT\n    a.ZONE_NAME,\n    a.[ZONE_VALID_FROM],a.[ZONE_VALID_TO],a.[FIRSTNAME],a.[LASTNAME],a.[EID],a.[ELID],a.[EMAIL],a.[JOBTITLE]\n           ,a.[AVAILABLE_TO_WORK],a.[HIRE_DATE],a.[EXPECTEDENDDATE],a.[ZONEOWNEREMAIL],a.[VENDOR_COMPANY]\n           ,a.[MANAGER_FIRST_NAME],a.[MANAGER_LASTNAME],a.[MANAGER_EMAIL],a.[MANAGER_NAME]\n           ,a.[ACCESS_KEEPER_ID],t.Datacenteralias,a.[UploadDate],a.[ETLUser]    \nFROM [dcm_dataloads].[acztotal] a\nINNER JOIN [dcm_dataloads].[tlkp_AccessZones] t\n    ON a.ZONE_NAME = t.ZONENAME;\n\nDELETE FROM [dcm_dataloads].[acztotal] where SiteAlias is NULL;\n\n--Update AVAILABLE_TO_WORK to 'Active' for 'Yes' as per old guardian system to avoid downstream impact\nUpdate [dcm_dataloads].[acztotal] set [AVAILABLE_TO_WORK]='ACTIVE' where [AVAILABLE_TO_WORK]='Yes'\n\n--Below statement is for updating Tr Cezanne sitealias as per KSL/ASL as Guardian is sending it in different way\nupdate [dcm_dataloads].[acztotal] set SiteAlias='TR Cézanne' where SiteAlias like '%TR%zanne%';\n\ndelete from [dcm_dataloads].[acztotal_hist] where format(uploaddate,'yyyy-MM') = format(DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()), 0),'yyyy-MM');\n\ninsert into [dcm_dataloads].[acztotal_hist]\nselect concat(Zone_name,LASTNAME,ACCESS_KEEPER_ID),*,format(uploaddate,'yyyy-MM') from [dcm_dataloads].[acztotal] where SiteAlias is NOT NULL;",
                "type" : "Expression"
              }
            } ],
            "scriptBlockExecutionTimeout" : null
          }
        }, {
