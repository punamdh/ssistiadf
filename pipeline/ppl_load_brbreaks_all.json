            "value" : "USE [kpikriReporting]\nGO\n\n\nDECLARE @EffectiveDate as date\nSET @EffectiveDate = ( SELECT DATEADD(YEAR, -3, GETDATE()) );\n\nTRUNCATE TABLE [QVSPINOFF].[tbl_Broadridge_DepositoryBreaks_View]\n\nINSERT INTO [QVSPINOFF].[tbl_Broadridge_DepositoryBreaks_View](\n [Metric_Date],\n [Process_Date],\n [Department],\n [Manager],\n [BreakName],\n [MetricName],\n [BreakMIS],\n [Status],\n [AssignGroup],\n [NewGroup],\n [Comment],\n [Age],\n [Client],\n [CUSIP],\n [BRBranch],\n [BRAccount],\n [Diff1],\n [Diff2],\n [Id],\n [DateModified],\n [ModifiedBy],\n [Product],\n loadDate,\n TotalCount\n) \nSELECT    \n   a.Process_Date as Metric_Date\n   ,a.Process_Date\n   ,a.Department\n   ,a.Manager\n   ,a.BreakName\n   ,MetricName = CASE WHEN a.BreakName = '048 Illogical Street Side PSN' or a.BreakName = 'Illogicals' THEN 'Broadridge - 048 Illogical Street Side Position Breaks'\n          WHEN a. BreakName = '031 Past Delivery Exceptions (MN)' THEN 'Broadridge - 031 Past Delivery Exceptions (MN) Breaks'\n          WHEN a. BreakName = 'Suspense Shares - Money' THEN 'Broadridge - Suspense Shares - Money Breaks'\n          WHEN a. BreakName = 'Deficits' THEN 'Broadridge - Deficit Breaks'\n          WHEN a. BreakName = 'BONYRec' THEN 'Broadridge - BONYRec Breaks'\n          WHEN a.BreakName = '046 Firm Balancing' THEN 'Broadridge - 046 Firm Balancing Breaks'\n          WHEN a.BreakName = 'DTC' THEN 'Broadridge - DTC Breaks'\n          WHEN a.BreakName = 'GPSRCBSecurity' THEN 'Broadridge - GPS Cash Breaks'\n          WHEN a.BreakName = 'GPSRCP' THEN 'Broadridge - GPS Position Breaks'\n          WHEN a.BreakName = 'GPSRCF' THEN 'Broadridge - GPS Fail Breaks'\n          WHEN a.BreakName = 'Ops – Subsystem' THEN 'Broadridge - Ops – Subsystem Breaks'\n          WHEN a.BreakName = 'Fixed Income Sub Allocate' THEN 'Broadridge - Fixed Income Sub Allocate Breaks'\n          WHEN a.BreakName = 'Purge' THEN 'Broadridge - Purge Breaks'\n          WHEN a.BreakName = 'Potential Purges' THEN 'Broadridge - Potential Purges Breaks'\n          WHEN a.BreakName = 'Operational' THEN 'Broadridge - Operational Breaks'\n          WHEN a.BreakName = 'GPSRCB' THEN 'Broadridge - GSP Cash Breaks'\n          WHEN a.AssignGroup  =  ' ' or a.Manager = ' ' or a.BreakName = a. BreakName THEN 'Not Mapped'\n          --WHEN  a.BreakName = a. BreakName THEN 'Not Mapped'\n          END\n   ,BreakMIS = CASE \n          WHEN a. BreakName = 'BONYRec' THEN 'BONYRec'          \n          WHEN a.BreakName = 'DTC' THEN 'DTC'\n          WHEN a.BreakName = 'GPSRCBSecurity' THEN 'GPSRCSecurity'\n          WHEN a.BreakName = 'GPSRCP' THEN 'GPSRCP'\n          WHEN a.BreakName = 'GPSRCF' THEN 'GPSRCF'\n          WHEN a.BreakName = 'LOANRECDetail' THEN 'LOANREC'        \n          END\n   ,a.[Status]\n   ,a.AssignGroup \n   ,b.[NewGroup]\n   ,a.Comment\n   ,a.Age\n   ,a.Client\n   ,a.CUSIP\n   ,a.BRBranch\n   ,a.BRAccount\n   ,a.Diff1\n   ,a.Diff2\n   ,a.[Id]\n   ,a.DateModified\n   ,a.ModifiedBy\n   ,'Break' \n   ,GETDATE()\n   ,count(a.ID) OVER (PARTITION BY a.Process_Date) AS TotalCount\n  FROM [kpikriReporting].dbo.[tbl_lvlThreeDetail_BRbreaks_ALL] a\n   Left Outer Join [kpikriReporting].[MAPPING].[tbl_Breaks_Remap] b\n        on a.AssignGroup = b.AssignGroup \n  WHERE cast(Process_Date as date) >= @EffectiveDate \n  AND a.AssignGroup IN ('FedGovtSettlements@wellsfargo.com', 'FedMBSSettlements1@wellsfargo.com', 'BrokerDealerCashMgt@wellsfargo.com')\n  AND a.Status  IN ('Action Needed', 'In Progress' )\n    \n \n  ",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
    }, {
