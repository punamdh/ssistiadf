              "sqlReaderStoredProcedureName" : null,
              "sqlReaderQuery" : "--Execute Stored Procedure \nEXEC dcm_dataloads.usp_AccessMetrics\n\n--1. SITE STATUS IS ACTIVE IN KSL, NOT IN GUARDIAN REPORT\n\nSELECT DISTINCT k.DataCenterAlias\nFROM dcm_dataloads.kslAdmin_Tbx k \nWHERE k.[SiteStatus] = 'Active' \nAND k.AccessSystem = 'Guardian'\nAND NOT EXISTS (\n      SELECT 1\n      FROM [dcm_dataloads].[AccessMetrics_Tbx] a\n      WHERE a.[SiteAlias] = k.[DataCenterAlias]\n        AND MONTH(a.[UploadDate]) = MONTH(GETDATE())\n        AND YEAR(a.[UploadDate]) = YEAR(GETDATE())\n\t\t);",
