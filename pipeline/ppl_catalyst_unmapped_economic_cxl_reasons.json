            "value" : "insert into [ReconControl].[dbo].tbl_Catalyst_EconomicStatusCancelReasons\nSELECT distinct\nA.cancel_reason,\n'New cancel reason with no Economic Status mapped' as [Economic Status],\nnull as Processed\nFROM [ReconControl].[dbo].[tbl_Catalyst_Trade](nolock) A\nleft join tbl_Catalyst_EconomicStatusCancelReasons B on A.cancel_reason = b.cancel_reason\nwhere \nA.trade_status = 'CNCL'\nand\nA.cancel_reason <> 'NULL'\nand\nA.cancel_reason <> ''\nand\nB.cancel_reason is null \norder by A.cancel_reason",
