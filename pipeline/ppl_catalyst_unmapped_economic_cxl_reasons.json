      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "Declare @CR varchar(50)\n\nWhile Exists (\nSelect *\nFrom [ReconControl].[dbo].tbl_Catalyst_EconomicStatusCancelReasons_AutoFlag \nWhere ECONOMIC_STATUS = 'Economic' and Processed is null \n)\n\nBegin\n    Select Top 1 @CR = REASON \n\tFrom [ReconControl].[dbo].tbl_Catalyst_EconomicStatusCancelReasons_AutoFlag \n\tWhere ECONOMIC_STATUS = 'Economic' and Processed is null\n    --Do some processing here\n\n\t update [ReconControl].[dbo].tbl_Catalyst_EconomicStatusCancelReasons\n\t set [economic status] = 'Economic'\n\t from [ReconControl].[dbo].tbl_Catalyst_EconomicStatusCancelReasons\n\t where CHARINDEX(@CR,cancel_reason) > 0\n\n\n\t --------- trouble shooting use only\n\t ----------select cancel_reason, \n\t ----------CHARINDEX(@CR,cancel_reason) as position\n\t ----------from [ReconControl].[dbo].tbl_Catalyst_EconomicStatusCancelReasons\n\n    --stop processing here\n\n\t--- incrementer\n    Update [ReconControl].[dbo].tbl_Catalyst_EconomicStatusCancelReasons_AutoFlag \n\tSet Processed = 1\n\tWhere REASON = @CR \nEnd\n",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
    }, {
      "name" : "ST_clear_process_flag_for_next_AutoFlag_Logic_run_",
