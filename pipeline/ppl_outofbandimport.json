          "sqlReaderStoredProcedureName" : null,
          "sqlReaderQuery" : "SELECT (SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OOB_Report_ContainerName' AND PIPELINE_NAME = 'OutofBandImport' AND DATAFLOW_NAME = 'Data_Flow_Task') AS Data_Flow_Task_OOBReport_ContainerName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OOB_Report_FileName' AND PIPELINE_NAME = 'OutofBandImport' AND DATAFLOW_NAME = 'Data_Flow_Task') AS Data_Flow_Task_OOBReport_FileName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OOB_Report_FilePath' AND PIPELINE_NAME = 'OutofBandImport' AND DATAFLOW_NAME = 'Data_Flow_Task') AS Data_Flow_Task_OOBReport_FilePath;",
          "storedProcedureParameters" : null,
          "queryTimeout" : "02:00:00",
          "partitionOption" : "None"
        },
        "dataset" : {
          "referenceName" : "DS_Metadata",
          "type" : "DatasetReference",
          "parameters" : {
            "TableName" : {
              "value" : "AZ_PARAMETERS",
              "type" : "Expression"
            },
            "Schema" : {
              "value" : "dbo",
              "type" : "Expression"
            }
          }
        },
        "firstRowOnly" : true
      }
    }, {
      "name" : "EP_REPL_Data_Flow_Task",
      "type" : "ExecutePipeline",
      "policy" : null,
      "dependsOn" : [ {
        "activity" : "LKP_Fetch_Param",
        "dependencyConditions" : [ "Succeeded" ]
      } ],
      "userProperties" : null,
      "state" : null,
      "description" : null,
      "onInactiveMarkAs" : null,
      "typeProperties" : {
        "pipeline" : {
          "referenceName" : "Generic_db_replication_ppl",
          "type" : "PipelineReference"
        },
        "waitOnCompletion" : true,
        "parameters" : {
          "SysDatetime" : {
            "value" : "@formatDateTime(pipeline().TriggerTime,'yyyyMMddHHmmss')",
            "type" : "Expression"
          },
          "Dataflow_Name" : "Data_Flow_Task",
          "FilePath_Date" : {
            "value" : "@pipeline().TriggerTime",
            "type" : "Expression"
          },
          "Pipeline_Name" : {
            "value" : "@pipeline().Pipeline",
            "type" : "Expression"
          }
        }
      }
    }, {
      "name" : "DF_Data_Flow_Task",
      "type" : "ExecuteDataFlow",
      "policy" : null,
      "dependsOn" : [ {
        "activity" : "EP_REPL_Data_Flow_Task",
        "dependencyConditions" : [ "Succeeded" ]
      } ],
      "state" : null,
      "description" : null,
      "onInactiveMarkAs" : null,
      "typeProperties" : {
        "dataflow" : {
          "referenceName" : "data_flow_task",
          "type" : "DataFlowReference",
          "parameters" : { },
          "datasetParameters" : {
            "OOBReport" : {
              "Container" : {
                "value" : "@activity('LKP_Fetch_Param').output.firstRow.Data_Flow_Task_OOBReport_ContainerName",
                "type" : "Expression"
              },
              "FileName" : {
                "value" : "@concat(activity('LKP_Fetch_Param').output.firstRow.Data_Flow_Task_OOBReport_FileName, '_', formatDateTime(pipeline().TriggerTime, 'yyyyMMddHHmmss'), '.parquet')",
                "type" : "Expression"
              },
              "Directory" : {
                "value" : "@concat(activity('LKP_Fetch_Param').output.firstRow.Data_Flow_Task_OOBReport_FilePath, '/', formatDateTime(pipeline().TriggerTime, 'yyyy/MM/dd'))",
                "type" : "Expression"
              }
            }
          }
        },
        "compute" : null,
        "staging" : {
          "linkedService" : {
            "referenceName" : "AzureBlobStorage1",
            "type" : "LinkedServiceReference"
          },
          "folderPath" : {
            "value" : "@pipeline().parameters.Data_Flow_Task_StagingFolderPath",
            "type" : "Expression"
          }
