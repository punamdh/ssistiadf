                "value" : "update [ReconControl].[dbo].[tbl_GSF_Open_Trades_Loan_import]\nset Count_Of_ContractKey = B.Count_Of_ContractKey\nFROM [ReconControl].[dbo].[tbl_GSF_Open_Trades_Loan_import] A\nleft join (\nselect \nA.[Biz Date], \nA.[Group], \nA.[Contract Type], \ncount([Contract Key]) as Count_Of_ContractKey\nFROM [ReconControl].[dbo].[tbl_GSF_Open_Trades_Loan_import] A\ngroup by A.[Biz Date], A.[Group], A.[Contract Type]\n) B \non A.[Biz Date] = B.[Biz Date] and A.[Group] = B.[Group] and A.[Contract Type] = B.[Contract Type]",
