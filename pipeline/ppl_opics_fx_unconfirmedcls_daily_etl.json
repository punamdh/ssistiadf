        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : " insert into [ReconControl].[dbo].[tbl_Opics_FX_Unconfirmed_Combined]\nselect \n\t\t'UnconfirmedCLS' as Source ,\n\t\t Branch ,\n\t\t MTSTATUS as Status ,\n\t\t DealNumber ,\n\t\t BuyCurrency as BoughtCCY ,\n\t\t BuyAmount as AmountBought ,\n\t\t SellCurrency as SoldCCY ,\n\t\t SellAmount as AmountSold ,\n\t\t '' as SENDERREF ,\n\t\t DEALDATE ,\n\t\t CTRPTYSUBMTNGPTYBIC as CUSTBIC ,\n\t\t '' as CustomerName ,\n\t\t ValueDate ,\n\t\t Age ,\n\t\t SettlementAmount ,\n         Getdate() as LoadDate, \n\t\t Getdate() as ReportDate\n from [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_Daily_Report]\n WHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date);",
            "type" : "Expression"
          }
        } ],
