      "typeProperties" : {
        "scripts" : [ {
          "type" : "NonQuery",
          "text" : {
            "value" : "\nUPDATE [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_Daily_Report]\nSET TotalConfirmation = (\n    SELECT COUNT(*)\n    FROM [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_Daily_Report]\n    WHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date)\n)\nWHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date);\n\n\nUPDATE [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_Daily_Report]\nSET Age = DATEDIFF(Day,DealDate, LoadDate)\nWHERE CAST(LOADDATE AS date) = CAST(GETDATE() AS date);\n\n   \nUPDATE rc\nSET rc.SettlementAmount =\n    CASE\n        WHEN fx.TERMS = 'D'\n            THEN CAST(rc.SellAmount AS decimal(18,4)) / fx.SPOTRATE_8\n        ELSE\n            rc.SellAmount * fx.SPOTRATE_8\n    END\nFROM [ReconControl].[dbo].[tbl_Opics_FX_UnconfirmedCLS_Daily_Report] rc\nJOIN [ReconControl].[dbo].[tbl_OTC_FX_Rates] fx\n    ON CAST(fx.LSTMNTDATE AS date) = CAST(DATEADD(DAY, CASE DATENAME(WEEKDAY, GETDATE()) \n                    WHEN 'Sunday' THEN -2 \n                    WHEN 'Monday' THEN -3 \n                    ELSE -1 END, DATEDIFF(DAY, -0, GETDATE())) AS date)\n   AND rc.SellCurrency = fx.CCY\nWHERE CAST(rc.Loaddate AS date) = CAST(GETDATE() AS date);\n",
            "type" : "Expression"
          }
        } ],
        "scriptBlockExecutionTimeout" : null
      }
    }, {
