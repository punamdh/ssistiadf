                  "text" : "DECLARE @rec as varchar(100)\nDECLARE @copy_rec as varchar(255)\nDECLARE @msg_body as varchar(500)\nDECLARE @msg_subject as varchar(200)\nDECLARE @max_loops as int\nDECLARE @loop_cnt as int\nDECLARE @delay_minutes as int\nDECLARE @impt as varchar(10)\n\nSET @rec=@var_recipients\nSET @copy_rec=@var_copy_recipients\nSET @max_loops =@var_max_loops\nSET @loop_cnt =@var_loop_cnt\nSET @delay_minutes =@var_delay_minutes\n\n\nSET @msg_subject='PHRDW Patient Matching Not Finished, Checked '+ CAST(@loop_cnt as varchar(32))+ ' out of ' +CAST(@max_loops as varchar(32))+' Times'\nIF @max_loops>@loop_cnt \nBEGIN\nSET @msg_body= 'Until the Patient Matching process is finished, other steps of PHRDW ETL cannot continue. Will retry in ' + CAST(@delay_minutes  as varchar(32)) +' minutes...'\nSET @impt='Normal'\nEND\nELSE \nBEGIN\nSET @msg_body= 'Giving up trying, please check the status of Patient Matching process. Other steps of the process will not continue. The package is marked as failed.'\nSET @impt='High'\nEND\nexec msdb.dbo.sp_send_dbmail\n@recipients = @rec,\n@copy_recipients=@copy_rec,\n@body =@msg_body,\n@body_format = 'TEXT' , \n@subject =@msg_subject,\n@importance=@impt"
