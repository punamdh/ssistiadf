          "typeProperties" : {
            "scripts" : [ {
              "type" : "Query",
              "text" : "SELECT \n    CASE \n        WHEN (SELECT COUNT(*) FROM [ecms].[patient_master] WHERE dss_create_dt_tm >= CAST(GETDATE() AS DATE)) > 0\n             AND (SELECT COUNT(*) FROM [ecms].[patient_alternate_set] WHERE dss_create_dt_tm >= CAST(GETDATE() AS DATE)) > 0\n             AND (SELECT COUNT(*) FROM [ecms].[tmp_patient_master]) + (SELECT COUNT(*) FROM [ecms].[tmp_patient_alternate_set]) = 0\n             AND EXISTS (SELECT 1 \n                         FROM [ecms].[brg_patient_level_c_status] \n                         WHERE CAST(last_refresh_dt_tm AS DATE) = CAST(GETDATE() AS DATE) \n                           AND status_description = 'Finished')\n        THEN 'Finished'\n        ELSE 'In Progress'\n    END "
